# ─── Required ────────────────────────────────────────────────────────────────

# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Encrypts SSO client secrets, integration tokens and calendar links at rest.
# Generate with: openssl rand -base64 32 — and keep it: losing it means
# re-entering every SSO/integration credential.
INTEGRATION_ENCRYPTION_KEY=

# Authenticates the bundled scheduler to the /api/cron/* job endpoints
# (recurring invoices, reminders, digest, Linear/calendar/Mercury sync).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Postgres (docker compose provisions the db service from these).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=consultainer

# Only needed when running the app outside Docker (e.g. `npm run dev`);
# docker compose builds it from the POSTGRES_* values above.
# DATABASE_URL=postgresql://app:change-me@localhost:5432/consultainer?schema=public

# ─── Recommended ─────────────────────────────────────────────────────────────

# If set, the first-run /setup page asks for this value before creating the
# admin account — stops anyone else claiming a fresh instance that's already
# reachable from the internet. Generate with: openssl rand -hex 16
SETUP_TOKEN=

# Host port the app is published on.
APP_PORT=3113

# Image tag to run (ghcr.io/armistice-group/retainer). "latest" follows every
# change to main; pin a release like 1.2.3 for controlled upgrades.
CONSULTAINER_VERSION=latest

# ─── Optional ────────────────────────────────────────────────────────────────

# Force one public URL. Usually leave unset: sign-in/SSO redirects follow
# whatever address the app is reached at, and the URL used in emails and
# share links is confirmed at /setup (editable in Settings → General).
# AUTH_URL=https://time.example.com
# SSO (OIDC) is configured in the app under Settings → Security, not here.

# Calendar links are only fetched from public addresses, so a link can't be
# used to reach this server's own network. Set to true if your calendars are
# served from a private network (e.g. Nextcloud on your LAN).
# ALLOW_PRIVATE_FETCH=false

# Integrations — email (Resend), QuickBooks, Linear, Stripe, and the file
# services (Google Drive, Dropbox, OneDrive/SharePoint, Notion) — are set up
# in the app (Settings → Integrations / Payments), which shows the exact
# callback URLs to register. Setting the variables below instead also works,
# and takes precedence over whatever is saved in the app.
#
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT=sandbox
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# LINEAR_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# "Continue with Google" login (this one is .env only).
# Redirect URI: <your URL>/api/auth/callback/google. New Google users only get
# in via an invite or an org's auto-join domain.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Keep uploads in S3-compatible storage (AWS S3, R2, MinIO, B2…) instead of
# the database, with a 25MB limit instead of 5MB. See docs/self-hosting.mdx.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=
