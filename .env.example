# Consultainer settings. Copy to .env next to docker-compose.yml, fill in the
# Required section, then run: docker compose up -d
# After changing anything here, run `docker compose up -d` again so the
# containers pick it up (`docker compose restart` does not re-read .env).
# Full guide: docs/self-hosting.mdx

# ─── Required ────────────────────────────────────────────────────────────────

# Signs login sessions and OAuth state. Changing it signs everyone out.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Encrypts SSO client secrets, integration credentials and tokens, and
# calendar links stored in the database. Must be base64 of exactly 32 bytes.
# Generate with: openssl rand -base64 32
# BACK IT UP outside this server: without it, a database backup can't decrypt
# those values and every SSO connection, integration and calendar has to be
# set up again. Don't change it once the instance is in use.
INTEGRATION_ENCRYPTION_KEY=

# Lets the bundled scheduler call the app's /api/cron/* job endpoints
# (recurring invoices, reminders, digest, Linear/calendar/Mercury sync,
# filing). Any random string; the scheduler and the app both read it from here.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# The Postgres database docker compose creates. Postgres only reads these the
# first time it creates its data volume; changing them afterwards breaks the
# app's connection (put the old values back). Set a long random password,
# e.g. openssl rand -hex 24. Keep the user and database name as they are.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=consultainer

# Only needed when running the app outside Docker (e.g. `npm run dev`);
# docker compose builds it from the POSTGRES_* values above.
# DATABASE_URL=postgresql://app:change-me@localhost:5432/consultainer?schema=public

# ─── Recommended ─────────────────────────────────────────────────────────────

# Set this if the server is reachable from the internet before you finish
# setup: the first-run /setup page then asks for this value before creating
# the owner account, so nobody else can claim the instance. No effect once
# setup is done. Generate with: openssl rand -hex 16
SETUP_TOKEN=

# Host port the app is published on (http://<this-host>:3113). Behind a
# reverse proxy on the same machine, use 127.0.0.1:3113 so the app is only
# reachable through the proxy.
APP_PORT=3113

# Image tag to run (ghcr.io/armistice-group/retainer). "latest" follows every
# change to main. Pin a release like 0.1.0 (exact) or 0.1 (newest patch) to
# upgrade on your own schedule.
CONSULTAINER_VERSION=latest

# ─── Optional ────────────────────────────────────────────────────────────────

# Forces one public URL for everything, including sign-in redirects. Usually
# leave unset: sign-in/SSO redirects follow whatever address the app is
# reached at, and the URL used in emails and share links is the "Instance URL"
# confirmed at /setup (owner can edit it in Settings → General).
# AUTH_URL=https://time.example.com

# SSO (OIDC: Okta, Entra ID, Google Workspace, ...) is configured in the app
# under Settings → Security, not here.

# Calendar links and Slack webhook URLs are only fetched from public addresses,
# so a URL can't be used to reach this server's own network. Set to true if
# your calendars (e.g. Nextcloud on your LAN) or a Slack-compatible webhook
# live on a private network.
# ALLOW_PRIVATE_FETCH=false

# Integrations: none are required. The owner can enter all of these in the app
# instead (Settings → Integrations, and Settings → Payments for Stripe), where
# each card shows the exact callback/webhook URL to register. A value set here
# takes precedence over the app and shows there as read-only.
#
# Email via Resend (resend.com → API Keys). Without it, invites and links are
# shared by hand and email-only features are off. The from-address must be on
# a domain you've verified in Resend, e.g. "Consultainer <billing@acme.com>".
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
#
# QuickBooks Online app from developer.intuit.com (Keys and credentials).
# Redirect URI: <your URL>/api/integrations/quickbooks/callback
# QUICKBOOKS_ENVIRONMENT is "sandbox" or "production".
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT=sandbox
#
# Linear OAuth app (Linear → Settings → API → OAuth applications).
# Callback URL: <your URL>/api/integrations/linear/callback
# Webhook (optional, for live updates): <your URL>/api/webhooks/linear; paste
# its signing secret as LINEAR_WEBHOOK_SECRET.
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# LINEAR_WEBHOOK_SECRET=
#
# Stripe Connect, for clients paying invoices online. Secret key from Stripe
# Dashboard → Developers → API keys; webhook endpoint
# <your URL>/api/webhooks/stripe and its signing secret. See
# docs/integrations/payments.mdx.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
#
# File services people connect to link and file documents. Redirect URIs:
# <your URL>/api/integrations/files/<google-drive|dropbox|onedrive|notion>/callback
# See docs/integrations/files.mdx.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# "Continue with Google" on the login page (only configurable here). Create an
# OAuth client of type "Web application" in Google Cloud console
# (APIs & Services → Credentials) with the redirect URI
# <your URL>/api/auth/callback/google. Leave empty to hide the button.
# New Google users only get in via an invite or an org's auto-join domain
# (Settings → Security).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Keep uploads in S3-compatible storage (AWS S3, Cloudflare R2, MinIO, B2...)
# instead of the database, raising the per-file limit from 5MB to 25MB.
# Turned on by setting S3_BUCKET. Use a private bucket and a key that can
# read, write and delete in it. Once files are in the bucket, keep these set.
# Existing uploads can be moved with scripts/move-files-to-object-storage.mts
# (see docs/self-hosting.mdx#file-storage).
#
# S3_BUCKET: bucket name.  S3_REGION: bucket region (R2: auto).
# S3_ENDPOINT: empty for AWS; e.g. https://<account-id>.r2.cloudflarestorage.com
#   or http://minio:9000.  S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: leave both
#   empty on AWS to use the instance role.  S3_FORCE_PATH_STYLE: true for MinIO
#   and most self-hosted servers.  S3_PREFIX: optional key prefix, e.g. consultainer/
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=
