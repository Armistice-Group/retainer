# ─── Required ────────────────────────────────────────────────────────────────

# Public URL people use to reach this instance (no trailing slash). Used for
# links in invites/emails and as the base of every OAuth/SSO redirect URI, so
# set it to your real domain once you put a reverse proxy in front.
AUTH_URL=http://localhost:3113

# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Encrypts SSO client secrets and integration tokens at rest.
# Generate with: openssl rand -base64 32 — and keep it: losing it means
# re-entering every SSO/integration credential.
INTEGRATION_ENCRYPTION_KEY=

# Authenticates the bundled scheduler to the /api/cron/* job endpoints
# (recurring invoices, Mercury payment sync). Generate with: openssl rand -hex 32
CRON_SECRET=

# Postgres (docker compose provisions the db service from these).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=consultainer

# Only needed when running the app outside Docker (e.g. `npm run dev`);
# docker compose builds it from the POSTGRES_* values above.
# DATABASE_URL=postgresql://app:change-me@localhost:5432/consultainer?schema=public

# ─── Recommended ─────────────────────────────────────────────────────────────

# If set, the first-run /setup page asks for this value before creating the
# admin account — stops anyone else claiming a fresh instance that's already
# reachable from the internet. Generate with: openssl rand -hex 16
SETUP_TOKEN=

# Host port the app is published on.
APP_PORT=3113

# ─── Optional ────────────────────────────────────────────────────────────────
# SSO (OIDC) is configured in the app under Settings → Security, not here.

# Email via Resend. Without it the app works fully: invite and contractor
# review links are shown to copy and share, and magic-link login is hidden.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# "Continue with Google" login. Redirect URI: <AUTH_URL>/api/auth/callback/google
# New Google users only get in via an invite or an org's auto-join domain.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# QuickBooks Online. Redirect URI: <AUTH_URL>/api/integrations/quickbooks/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

# Linear. Callback URL: <AUTH_URL>/api/integrations/linear/callback, scope "read".
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Stripe Connect, for "Pay now" on invoices (Settings → Payments).
# Webhook endpoint: <AUTH_URL>/api/webhooks/stripe, event checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
