generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum BillingType {
  HOURLY
  FLAT_FEE
  MILESTONE
}

enum ClientDocumentType {
  W9
  FORM_1099
  CONTRACT
  OTHER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum LinkType {
  LOGIN
  GDRIVE
  ONEDRIVE
  BOX
  DOC
  REPO
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET15
  NET30
  NET45
  NET60
  NET90
  CUSTOM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum NotificationType {
  MEMBER_JOINED
  PROJECT_ASSIGNED
  TASK_ASSIGNED
  INVOICE_SENT
  INVOICE_PAID
  TIME_LOGGED
  RECURRING_INVOICE_GENERATED
}

enum Plan {
  FREE
  PAID
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  domain               String?  @unique
  autoJoinDomain       Boolean  @default(true)
  invoicePrefix        String   @default("INV")
  nextInvoiceNumber    Int      @default(1)
  defaultCurrency      String   @default("USD")
  defaultTaxRate       Decimal  @default(0) @db.Decimal(5, 2)
  // Applied to the billed rate on hourly line items at invoice-generation
  // time — a straight multiplier baked into the rate shown on the invoice,
  // never broken out as its own line. Distinct from defaultTaxRate, which
  // is a visible, itemized "Tax" line.
  overheadPercent      Decimal  @default(0) @db.Decimal(5, 2)
  externalBillingUrl   String?
  externalBillingLabel String?
  slackWebhookUrl      String?
  logoUrl              String?
  logoData             Bytes?
  logoContentType      String?
  brandColor           String?

  // A non-admin's logged expense above this amount needs OWNER/ADMIN
  // approval before it can be pulled onto an invoice; admins' own expenses
  // are always auto-approved regardless of amount.
  expenseApprovalThreshold Decimal @default(100) @db.Decimal(12, 2)

  // Billing (Stripe) — plan is the source of truth for feature gating;
  // kept in sync with Stripe via webhook, never set directly from client
  // input. stripeSubscriptionStatus is for display/debugging only.
  plan                     Plan     @default(FREE)
  stripeCustomerId         String?  @unique
  stripeSubscriptionId     String?  @unique
  stripeSubscriptionStatus String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships          Membership[]
  invites              Invite[]
  clients              Client[]
  projects             Project[]
  timeEntries          TimeEntry[]
  invoices             Invoice[]
  recurringInvoiceSchedules RecurringInvoiceSchedule[]
  notifications        Notification[]
  apiKeys              ApiKey[]
  quickBooksConnection QuickBooksConnection?
  githubConnection     GithubConnection?
  linearConnection     LinearConnection?
  laurelConnection     LaurelConnection?
  ssoConnection        SsoConnection?
  expenses             Expense[]
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String?
  name                   String
  twoFactorSecret        String?
  twoFactorEnabled       Boolean  @default(false)
  twoFactorRecoveryCodes String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  memberships                 Membership[]
  projectMembers              ProjectMember[]
  timeEntries                 TimeEntry[]
  invitesSent                 Invite[]               @relation("InvitedBy")
  assignedTasks               Task[]
  notifications               Notification[]
  apiKeys                     ApiKey[]
  connectedQuickBooksAccounts QuickBooksConnection[]
  connectedGithubAccounts     GithubConnection[]
  connectedLinearAccounts     LinearConnection[]
  connectedLaurelAccounts     LaurelConnection[]
  authenticators              Authenticator[]
  webAuthnChallenges          WebAuthnChallenge[]
  connectedSsoAccounts        SsoConnection[]
  ssoLoginTickets             SsoLoginTicket[]
  pendingEmailChanges         PendingEmailChange[]
  completedMilestones         Milestone[]
  uploadedClientDocuments     ClientDocument[]
  expensesSubmitted           Expense[]              @relation("ExpenseSubmittedBy")
  expensesApproved            Expense[]              @relation("ExpenseApprovedBy")
}

enum MembershipType {
  EMPLOYEE
  CONTRACTOR
}

model Membership {
  id             String         @id @default(cuid())
  role           Role           @default(MEMBER)
  employmentType MembershipType @default(EMPLOYEE)

  // Contractor profile — self-edited from Profile, shown to clients on a
  // per-project approval review when requested for a CONTRACTOR.
  title              String?
  bio                String?
  resumeFileName     String?
  resumeFileData     Bytes?
  resumeContentType  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invite {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  email     String?
  role      Role      @default(MEMBER)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invitedById String?
  invitedBy   User?   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model Client {
  id             String       @id @default(cuid())
  name           String
  website        String?
  description    String?
  email          String?
  phone          String?
  address        String?
  billingEmail   String?
  billingAddress String?
  status         ClientStatus @default(ACTIVE)
  shareToken     String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  quickbooksCustomerId String?

  contacts                  Contact[]
  links                     Link[]
  projects                  Project[]
  invoices                  Invoice[]
  documents                 ClientDocument[]
  recurringInvoiceSchedules RecurringInvoiceSchedule[]

  @@index([orgId])
}

model ClientDocument {
  id          String             @id @default(cuid())
  type        ClientDocumentType @default(OTHER)
  label       String?
  fileName    String
  fileData    Bytes
  contentType String
  uploadedAt  DateTime           @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model Contact {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  title            String?
  contactRole      String?
  isPrimary        Boolean  @default(false)
  receivesInvoices Boolean  @default(false)
  createdAt        DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// A user can type any new email into "Change email" — this holds the change
// until they prove they control that inbox, so a compromised session can't
// be used to pivot into someone else's real address (and, downstream, claim
// their company's domain via org Security settings).
model PendingEmailChange {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  newEmail  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Link {
  id    String   @id @default(cuid())
  label String
  url   String
  type  LinkType @default(OTHER)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([projectId])
}

model Project {
  id                     String        @id @default(cuid())
  name                   String
  description            String?
  status                 ProjectStatus @default(ACTIVE)
  startDate              DateTime?
  endDate                DateTime?
  codeHealthGateEnabled  Boolean       @default(false)
  confidential           Boolean       @default(false)
  budgetHours            Decimal?      @db.Decimal(7, 2)
  billingType            BillingType   @default(HOURLY)
  flatFeeAmount          Decimal?      @db.Decimal(12, 2)
  shareToken             String?       @unique
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  links            Link[]
  members          ProjectMember[]
  tasks            Task[]
  timeEntries      TimeEntry[]
  invoiceLineItems InvoiceLineItem[]
  milestones       Milestone[]
  expenses         Expense[]
  repo             Repo?
  externalLink     ExternalProjectLink?

  @@index([orgId])
  @@index([clientId])
}

model Milestone {
  id          String   @id @default(cuid())
  name        String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  dueDate     DateTime? @db.Date
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Evidence of completion — required note plus an optional file or link,
  // captured atomically in the same action that marks the milestone done.
  // No separate evidence table: one completion event, one evidence bundle.
  completedAt   DateTime?
  completedById String?
  completedBy   User?   @relation(fields: [completedById], references: [id], onDelete: SetNull)
  completionNote String?
  completionUrl  String?

  completionFileName        String?
  completionFileData        Bytes?
  completionFileContentType String?

  // Milestone-based invoicing: a completed milestone becomes its own line
  // item (quantity 1, rate = amount) when included on a generated invoice —
  // mirrors TimeEntry's invoiceLineItemId, but @unique since a milestone
  // always maps to exactly one line item rather than being grouped.
  invoiceLineItemId String?          @unique
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)
  invoicedAt        DateTime?

  @@index([projectId])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  estimatedHours Decimal?   @db.Decimal(6, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  timeEntries  TimeEntry[]
  externalLink ExternalTaskLink?

  @@index([projectId])
  @@index([assigneeId])
}

enum ProjectMemberApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model ProjectMember {
  id       String  @id @default(cuid())
  billRate Decimal @default(0) @db.Decimal(10, 2)
  currency String  @default("USD")

  // Client review of a contractor's staffing on this project — optional,
  // requested by an admin when adding a CONTRACTOR. NOT_REQUIRED (the
  // default) means no review was ever asked for; approvalToken is only set
  // while a review is pending or has been responded to.
  approvalStatus      ProjectMemberApprovalStatus @default(NOT_REQUIRED)
  approvalToken       String?                      @unique
  approvalRequestedAt DateTime?
  approvalRespondedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Expense {
  id          String        @id @default(cuid())
  description String
  category    String?
  amount      Decimal       @db.Decimal(12, 2)
  incurredAt  DateTime      @db.Date
  status      ExpenseStatus @default(APPROVED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)

  approvedById String?
  approvedBy   User?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  receiptFileName    String?
  receiptFileData    Bytes?
  receiptContentType String?

  // Mirrors Milestone: an approved, unbilled expense becomes its own line
  // item (quantity 1, rate = amount) when pulled onto a generated invoice.
  invoiceLineItemId String?          @unique
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)
  invoicedAt        DateTime?

  @@index([orgId])
  @@index([projectId])
}

model TimeEntry {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  hours        Decimal  @db.Decimal(5, 2)
  description  String?
  billable     Boolean  @default(true)
  rateOverride Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  invoiceLineItemId String?
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)

  externalLink ExternalTimeEntryLink?

  @@index([orgId])
  @@index([projectId])
  @@index([userId])
  @@index([date])
  @@index([taskId])
}

model Invoice {
  id            String        @id @default(cuid())
  number        String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  paymentTerms  PaymentTerms  @default(NET30)
  poNumber      String?
  paymentMethod String?
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  currency      String        @default("USD")
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  quickbooksInvoiceId String?
  quickbooksSyncedAt  DateTime?

  lineItems InvoiceLineItem[]

  recurringScheduleId String?
  recurringSchedule   RecurringInvoiceSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([orgId])
  @@index([clientId])
}

enum RecurringInterval {
  WEEKLY
  MONTHLY
}

// A retainer-style billing schedule: a flat amount charged to a client on a
// recurring cadence. Deliberately separate from generateInvoice's time/
// milestone/expense-driven flow — a retainer charge isn't "unbilled" work,
// it's a standing fee, so each run creates one manual line item rather than
// pulling in TimeEntry/Milestone/Expense records.
model RecurringInvoiceSchedule {
  id          String            @id @default(cuid())
  description String
  amount      Decimal           @db.Decimal(12, 2)
  interval    RecurringInterval @default(MONTHLY)
  dueInDays   Int               @default(30)
  active      Boolean           @default(true)
  // Draft by default so a human reviews before it goes out; an org that
  // trusts the schedule can flip this on to skip that step.
  autoSend    Boolean           @default(false)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  generatedInvoices Invoice[]

  @@index([orgId])
  @@index([clientId])
  @@index([nextRunAt])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(8, 2)
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  timeEntries TimeEntry[]
  milestone   Milestone?
  expense     Expense?

  @@index([invoiceId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([orgId])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
}

model QuickBooksConnection {
  id                   String   @id @default(cuid())
  realmId              String
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  defaultItemId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

model GithubConnection {
  id          String   @id @default(cuid())
  login       String
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  repos Repo[]
}

model Repo {
  id          String   @id @default(cuid())
  githubOwner String
  githubName  String
  installedAt DateTime @default(now())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  connectionId String
  connection   GithubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  scans Scan[]

  @@index([connectionId])
}

model Scan {
  id        String   @id @default(cuid())
  score     Int
  findings  Json
  createdAt DateTime @default(now())

  repoId String
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, createdAt])
}

// ── Task tracker / time tracker integrations ─────────────────────────────────
// Generic mapping layer: any external source (Linear, Rize, Laurel, ...) links
// into Retainer's own Project/Task/TimeEntry rows via these tables, tagged by
// a `source` string, rather than each integration needing its own schema.

model LinearConnection {
  id            String   @id @default(cuid())
  workspaceName String?
  accessToken   String
  scope         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

model ExternalProjectLink {
  id           String   @id @default(cuid())
  source       String
  externalId   String
  externalName String?
  createdAt    DateTime @default(now())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

model ExternalTaskLink {
  id           String    @id @default(cuid())
  source       String
  externalId   String
  externalUrl  String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

model ExternalTimeEntryLink {
  id         String   @id @default(cuid())
  source     String
  externalId String
  createdAt  DateTime @default(now())

  timeEntryId String    @unique
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

// Laurel's data-sync endpoints (pending time entries, client/matter push) are
// provisioned per-customer by Laurel's solutions team and aren't in public
// docs — this connection stores the OAuth2 client_credentials, which is
// enough to authenticate; the actual sync endpoints are a follow-up
// (see Linear ARM-63) once a real customer/client ID pair exists.
model LaurelConnection {
  id           String    @id @default(cuid())
  customerId   String
  clientId     String
  clientSecret String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

// ── Passkeys (WebAuthn) ───────────────────────────────────────────────────────

model Authenticator {
  id           String    @id @default(cuid())
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt
  transports   String?
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived challenge for an in-progress registration or login ceremony.
// userId is set for registration (we know who); null for a discoverable
// (usernameless) login ceremony, resolved to a user only after verification.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── SSO (OIDC) ─────────────────────────────────────────────────────────────
// Per-org OIDC identity provider (Okta, Authentik, etc.) — not gated behind a
// billing tier yet since no billing enforcement exists in the app (see
// pricing page discussion); wire that gate in when it does.

model SsoConnection {
  id                    String   @id @default(cuid())
  issuer                String
  clientId              String
  clientSecret          String
  authorizationEndpoint String
  tokenEndpoint         String
  jwksUri               String
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

// Single-use, short-lived ticket bridging the OIDC callback (a plain Route
// Handler, where next-auth's signIn()/redirect() can't be called directly)
// to the "sso" Credentials provider, consumed via a Server Component page —
// same shape/reasoning as the passkey login ticket.
model SsoLoginTicket {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Holds a credentials signup that would otherwise link to a domain — join an
// existing org via auto-join, or claim a domain for a brand-new org — until
// the email is confirmed. Nothing is created (no User, no Membership, no
// domain claim) until the link is clicked; typing someone else's email at
// signup must not be enough to get into their org or squat their domain.
model PendingSignup {
  id                   String   @id @default(cuid())
  token                String   @unique
  email                String
  name                 String
  passwordHash         String
  orgName              String
  autoJoinOrgId        String?
  claimableDomain      String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([email])
}
