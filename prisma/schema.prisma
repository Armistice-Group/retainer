generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum BillingType {
  HOURLY
  FLAT_FEE
  MILESTONE
}

enum ClientDocumentType {
  W9
  FORM_1099
  CONTRACT
  OTHER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum LinkType {
  LOGIN
  GDRIVE
  ONEDRIVE
  BOX
  DOC
  REPO
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET15
  NET30
  NET45
  NET60
  NET90
  CUSTOM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum NotificationType {
  MEMBER_JOINED
  PROJECT_ASSIGNED
  TASK_ASSIGNED
  INVOICE_SENT
  INVOICE_PAID
  TIME_LOGGED
  RECURRING_INVOICE_GENERATED
  INVOICE_OVERDUE
  TASK_COMMENTED
}

enum Plan {
  FREE
  PAID
  // Adds Stripe Connect — the org can collect payment directly on invoices,
  // not just generate and send them.
  GROWTH
}

model Organization {
  id                         String  @id @default(cuid())
  name                       String
  slug                       String  @unique
  domain                     String? @unique
  autoJoinDomain             Boolean @default(true)
  invoicePrefix              String  @default("INV")
  nextInvoiceNumber          Int     @default(1)
  defaultCurrency            String  @default("USD")
  defaultTaxRate             Decimal @default(0) @db.Decimal(5, 2)
  // Applied to the billed rate on hourly line items at invoice-generation
  // time — a straight multiplier baked into the rate shown on the invoice,
  // never broken out as its own line. Distinct from defaultTaxRate, which
  // is a visible, itemized "Tax" line.
  overheadPercent            Decimal @default(0) @db.Decimal(5, 2)
  externalBillingUrl         String?
  externalBillingLabel       String?
  // Free text, not a structured payment-method schema — orgs accept wildly
  // different combinations (ACH details, a Stripe/PayPal payment link, a
  // mailing address for checks), so a single configurable block that gets
  // printed verbatim on every invoice PDF is more useful than a rigid set of
  // fields most orgs would only partially fill in.
  paymentInstructions        String? @db.Text
  // When true, paymentInstructions is withheld from the plain PDF (which can
  // be forwarded/leaked anywhere) and only shown on the authenticated client
  // share portal — for orgs whose instructions include bank/ACH details.
  paymentInstructionsPrivate Boolean @default(false)
  slackWebhookUrl            String?
  logoUrl                    String?
  logoData                   Bytes?
  logoContentType            String?
  brandColor                 String?
  // Optional in-app branding: show the org's logo/name in the sidebar and on
  // the login page instead of Consultainer's, and/or use brandColor as the
  // UI accent. Off by default; invoices use the logo/color regardless.
  appBranding                Boolean @default(false)
  appAccentFromBrand         Boolean @default(false)

  // A non-admin's logged expense above this amount needs OWNER/ADMIN
  // approval before it can be pulled onto an invoice; admins' own expenses
  // are always auto-approved regardless of amount.
  expenseApprovalThreshold Decimal @default(100) @db.Decimal(12, 2)

  // Legacy hosted-billing columns — unused on self-hosted instances (no plan
  // gating), kept so existing databases migrate cleanly.
  plan                     Plan    @default(FREE)
  stripeCustomerId         String? @unique
  stripeSubscriptionId     String? @unique
  stripeSubscriptionStatus String?

  // Stripe Connect — lets this org collect invoice payments
  // directly. chargesEnabled mirrors Stripe's own flag (set from
  // account.updated webhooks) rather than being inferred from "account
  // exists", since an Express account can exist mid-onboarding without
  // being able to actually take a payment yet.
  stripeConnectAccountId      String? @unique
  stripeConnectChargesEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships               Membership[]
  invites                   Invite[]
  clients                   Client[]
  projects                  Project[]
  timeEntries               TimeEntry[]
  invoices                  Invoice[]
  recurringInvoiceSchedules RecurringInvoiceSchedule[]
  billingCycles             ClientBillingCycle[]
  paymentMethods            PaymentMethod[]
  notifications             Notification[]
  apiKeys                   ApiKey[]
  quickBooksConnection      QuickBooksConnection?
  linearConnection          LinearConnection?
  mercuryConnection         MercuryConnection?
  ssoConnection             SsoConnection?
  expenses                  Expense[]
  activeTimers              ActiveTimer[]
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String?
  name                   String
  twoFactorSecret        String?
  twoFactorEnabled       Boolean  @default(false)
  twoFactorRecoveryCodes String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  memberships                 Membership[]
  projectMembers              ProjectMember[]
  timeEntries                 TimeEntry[]
  invitesSent                 Invite[]               @relation("InvitedBy")
  assignedTasks               Task[]
  notifications               Notification[]
  apiKeys                     ApiKey[]
  connectedQuickBooksAccounts QuickBooksConnection[]
  connectedLinearAccounts     LinearConnection[]
  connectedMercuryAccounts    MercuryConnection[]
  authenticators              Authenticator[]
  webAuthnChallenges          WebAuthnChallenge[]
  connectedSsoAccounts        SsoConnection[]
  ssoLoginTickets             SsoLoginTicket[]
  pendingEmailChanges         PendingEmailChange[]
  completedMilestones         Milestone[]
  uploadedClientDocuments     ClientDocument[]
  expensesSubmitted           Expense[]              @relation("ExpenseSubmittedBy")
  expensesApproved            Expense[]              @relation("ExpenseApprovedBy")
  taskComments                TaskComment[]
  activeTimer                 ActiveTimer?
}

enum MembershipType {
  EMPLOYEE
  CONTRACTOR
}

model Membership {
  id             String         @id @default(cuid())
  role           Role           @default(MEMBER)
  employmentType MembershipType @default(EMPLOYEE)

  // Contractor profile — self-edited from Profile, shown to clients on a
  // per-project approval review when requested for a CONTRACTOR.
  title             String?
  bio               String?
  resumeFileName    String?
  resumeFileData    Bytes?
  resumeContentType String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invite {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  email     String?
  role      Role      @default(MEMBER)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invitedById String?
  invitedBy   User?   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model Client {
  id                         String       @id @default(cuid())
  name                       String
  website                    String?
  description                String?
  email                      String?
  phone                      String?
  address                    String?
  billingEmail               String?
  billingAddress             String?
  // Overrides Organization.paymentInstructions for this client's invoices
  // specifically (e.g. a client that only accepts wire transfer). Null means
  // "use the org default" — an empty override isn't representable on
  // purpose, since "this client has no payment instructions at all" isn't a
  // real state anyone wants; they'd just fall back to the org default.
  paymentInstructions        String?      @db.Text
  paymentInstructionsPrivate Boolean?
  status                     ClientStatus @default(ACTIVE)
  shareToken                 String?      @unique
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  quickbooksCustomerId String?
  mercuryCustomerId    String?

  contacts                  Contact[]
  links                     Link[]
  projects                  Project[]
  invoices                  Invoice[]
  documents                 ClientDocument[]
  recurringInvoiceSchedules RecurringInvoiceSchedule[]
  billingCycle              ClientBillingCycle?
  paymentMethods            PaymentMethod[]

  @@index([orgId])
}

model ClientDocument {
  id          String             @id @default(cuid())
  type        ClientDocumentType @default(OTHER)
  label       String?
  fileName    String
  fileData    Bytes
  contentType String
  uploadedAt  DateTime           @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model Contact {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  title            String?
  contactRole      String?
  isPrimary        Boolean  @default(false)
  receivesInvoices Boolean  @default(false)
  createdAt        DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// A user can type any new email into "Change email" — this holds the change
// until they prove they control that inbox, so a compromised session can't
// be used to pivot into someone else's real address (and, downstream, claim
// their company's domain via org Security settings).
model PendingEmailChange {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  newEmail  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Link {
  id    String   @id @default(cuid())
  label String
  url   String
  type  LinkType @default(OTHER)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([projectId])
}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  status        ProjectStatus @default(ACTIVE)
  startDate     DateTime?
  endDate       DateTime?
  confidential  Boolean       @default(false)
  budgetHours   Decimal?      @db.Decimal(7, 2)
  billingType   BillingType   @default(HOURLY)
  flatFeeAmount Decimal?      @db.Decimal(12, 2)
  shareToken    String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  links            Link[]
  members          ProjectMember[]
  tasks            Task[]
  timeEntries      TimeEntry[]
  invoiceLineItems InvoiceLineItem[]
  milestones       Milestone[]
  expenses         Expense[]
  externalLink     ExternalProjectLink?
  activeTimers     ActiveTimer[]

  @@index([orgId])
  @@index([clientId])
}

model Milestone {
  id          String    @id @default(cuid())
  name        String
  description String?
  amount      Decimal   @db.Decimal(12, 2)
  dueDate     DateTime? @db.Date
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Evidence of completion — required note plus an optional file or link,
  // captured atomically in the same action that marks the milestone done.
  // No separate evidence table: one completion event, one evidence bundle.
  completedAt    DateTime?
  completedById  String?
  completedBy    User?     @relation(fields: [completedById], references: [id], onDelete: SetNull)
  completionNote String?
  completionUrl  String?

  completionFileName        String?
  completionFileData        Bytes?
  completionFileContentType String?

  // Milestone-based invoicing: a completed milestone becomes its own line
  // item (quantity 1, rate = amount) when included on a generated invoice —
  // mirrors TimeEntry's invoiceLineItemId, but @unique since a milestone
  // always maps to exactly one line item rather than being grouped.
  invoiceLineItemId String?          @unique
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)
  invoicedAt        DateTime?

  @@index([projectId])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  estimatedHours Decimal?   @db.Decimal(6, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  timeEntries  TimeEntry[]
  externalLink ExternalTaskLink?
  activeTimers ActiveTimer[]
  comments     TaskComment[]

  @@index([projectId])
  @@index([assigneeId])
}

// Internal discussion on a task — never shown on the client share link. When
// the task is linked to a Linear issue the author can also post the comment
// there; externalId/externalUrl then point at the Linear comment.
model TaskComment {
  id          String   @id @default(cuid())
  body        String
  externalId  String?
  externalUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

enum ProjectMemberApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model ProjectMember {
  id       String  @id @default(cuid())
  billRate Decimal @default(0) @db.Decimal(10, 2)
  currency String  @default("USD")

  // Client review of a contractor's staffing on this project — optional,
  // requested by an admin when adding a CONTRACTOR. NOT_REQUIRED (the
  // default) means no review was ever asked for; approvalToken is only set
  // while a review is pending or has been responded to.
  approvalStatus      ProjectMemberApprovalStatus @default(NOT_REQUIRED)
  approvalToken       String?                     @unique
  approvalRequestedAt DateTime?
  approvalRespondedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Expense {
  id          String        @id @default(cuid())
  description String
  category    String?
  amount      Decimal       @db.Decimal(12, 2)
  incurredAt  DateTime      @db.Date
  status      ExpenseStatus @default(APPROVED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)

  approvedById String?
  approvedBy   User?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  receiptFileName    String?
  receiptFileData    Bytes?
  receiptContentType String?

  // Mirrors Milestone: an approved, unbilled expense becomes its own line
  // item (quantity 1, rate = amount) when pulled onto a generated invoice.
  invoiceLineItemId String?          @unique
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)
  invoicedAt        DateTime?

  @@index([orgId])
  @@index([projectId])
}

model TimeEntry {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  hours        Decimal  @db.Decimal(5, 2)
  description  String?
  billable     Boolean  @default(true)
  rateOverride Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  invoiceLineItemId String?
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)

  externalLink ExternalTimeEntryLink?

  @@index([orgId])
  @@index([projectId])
  @@index([userId])
  @@index([date])
  @@index([taskId])
}

// The one currently-running timer for a user, app-wide — not per-org, since
// a person is only ever doing one thing at a time regardless of which org's
// work it's for. Stopping it converts the elapsed duration into a real
// TimeEntry; starting a new one while another is running stops-and-logs the
// old one first rather than blocking, matching how Toggl/Harvest behave.
model ActiveTimer {
  id          String   @id @default(cuid())
  startedAt   DateTime @default(now())
  description String?
  billable    Boolean  @default(true)
  createdAt   DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model Invoice {
  id                      String        @id @default(cuid())
  number                  String
  status                  InvoiceStatus @default(DRAFT)
  issueDate               DateTime      @db.Date
  dueDate                 DateTime      @db.Date
  paymentTerms            PaymentTerms  @default(NET30)
  poNumber                String?
  paymentMethod           String?
  subtotal                Decimal       @default(0) @db.Decimal(12, 2)
  taxRate                 Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount               Decimal       @default(0) @db.Decimal(12, 2)
  total                   Decimal       @default(0) @db.Decimal(12, 2)
  currency                String        @default("USD")
  notes                   String?
  // Guards notifyNewlyOverdueInvoices against sending a duplicate ping if the
  // daily cron ever fires more than once while an invoice is still exactly
  // one day overdue (manual re-trigger, EventBridge retry, etc).
  overdueNotifiedAt       DateTime?
  // Snapshot of the schedule's retainerHours at generation time (not a live
  // lookup) so a client's billed-vs-logged balance stays accurate even if the
  // schedule's hours are edited later. Only set for retainer-generated
  // invoices whose schedule tracks hours.
  retainerHoursIncluded   Decimal?      @db.Decimal(8, 2)
  // Set once a "Pay now" checkout is started/completed for this invoice
  // (Growth plan, Stripe Connect). paymentIntentId is the actual proof of
  // payment the webhook uses to mark PAID — sessionId alone isn't, since a
  // session can be abandoned without paying.
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?       @unique
  // Same idea as the Stripe fields above, for orgs paying through a
  // connected Mercury account instead — mercuryInvoiceId is Mercury's own
  // invoice id (used to poll status, since Mercury doesn't webhook invoice
  // payments), mercuryInvoiceSlug builds the hosted pay page URL. Set once,
  // on first "Pay now" click, so repeat clicks reuse the same Mercury
  // invoice instead of creating duplicates.
  mercuryInvoiceId        String?       @unique
  mercuryInvoiceSlug      String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  quickbooksInvoiceId String?
  quickbooksSyncedAt  DateTime?

  lineItems InvoiceLineItem[]

  recurringScheduleId String?
  recurringSchedule   RecurringInvoiceSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([orgId])
  @@index([clientId])
}

enum RecurringInterval {
  WEEKLY
  BIWEEKLY
  // Runs on the 1st and 15th of each month.
  SEMIMONTHLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// A retainer-style billing schedule: a flat amount charged to a client on a
// recurring cadence. Deliberately separate from generateInvoice's time/
// milestone/expense-driven flow — a retainer charge isn't "unbilled" work,
// it's a standing fee, so each run creates one manual line item rather than
// pulling in TimeEntry/Milestone/Expense records.
model RecurringInvoiceSchedule {
  id            String            @id @default(cuid())
  description   String
  amount        Decimal           @db.Decimal(12, 2)
  interval      RecurringInterval @default(MONTHLY)
  dueInDays     Int               @default(30)
  // Optional — lets a retainer be tracked in hours (e.g. "$5,000/mo = 40 hrs")
  // so the client page can show a running billed-vs-logged balance. Null for
  // retainers that are just a flat fee with no hours dimension.
  retainerHours Decimal?          @db.Decimal(8, 2)
  active        Boolean           @default(true)
  // Draft by default so a human reviews before it goes out; an org that
  // trusts the schedule can flip this on to skip that step.
  autoSend      Boolean           @default(false)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  generatedInvoices Invoice[]

  @@index([orgId])
  @@index([clientId])
  @@index([nextRunAt])
}

// Optional per-client billing cadence for ordinary (non-retainer) work: on
// each run, everything unbilled for the client — billable time, completed
// milestones, approved expenses — dated before the run date is rolled into
// one invoice via the same generateInvoice() path as the manual flow. A run
// with nothing to bill creates no invoice and just advances.
model ClientBillingCycle {
  id            String            @id @default(cuid())
  interval      RecurringInterval
  // Day of month the cycle was started on, so monthly-or-longer cycles that
  // get clamped (Jan 31 → Feb 28) snap back to the 31st afterwards instead
  // of drifting.
  anchorDay     Int
  paymentTerms  PaymentTerms      @default(NET30)
  // Draft by default so a human reviews before it goes out.
  autoSend      Boolean           @default(false)
  active        Boolean           @default(true)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  // Outcome of the last run, for display: the invoice it created, or why it
  // didn't create one.
  lastInvoiceId String?
  lastRunNote   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(8, 2)
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  timeEntries TimeEntry[]
  milestone   Milestone?
  expense     Expense?

  @@index([invoiceId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([orgId])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
}

model QuickBooksConnection {
  id                   String   @id @default(cuid())
  realmId              String
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  defaultItemId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

// Mercury Bank — an alternative to Stripe Connect for Growth-plan orgs that
// already bank with Mercury. Unlike QuickBooks/Linear above, this isn't an
// OAuth app we operate (Mercury's OAuth requires Mercury's own manual
// platform approval before we could get client credentials at all) — the
// org generates its own long-lived personal API token in their Mercury
// dashboard (Settings > Tokens) and pastes it in, so there's no redirect
// flow and no refresh token to manage. destinationAccountId is which of the
// org's Mercury checking accounts invoice payments land in.
model MercuryConnection {
  id                     String   @id @default(cuid())
  apiToken               String
  destinationAccountId   String?
  destinationAccountName String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

// ── Task tracker / time tracker integrations ─────────────────────────────────
// Generic mapping layer: any external source (Linear, Rize, Laurel, ...) links
// into Retainer's own Project/Task/TimeEntry rows via these tables, tagged by
// a `source` string, rather than each integration needing its own schema.

model LinearConnection {
  id                   String    @id @default(cuid())
  workspaceName        String?
  accessToken          String
  // Linear access tokens last 24h; the refresh token rotates on every use.
  // Both encrypted. Null on connections made before refresh tokens existed.
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  scope                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

model ExternalProjectLink {
  id                String    @id @default(cuid())
  source            String
  // Linear: the team. Several Consultainer projects (one per client, say)
  // can share a team, each narrowed by a Linear project and/or labels below.
  externalId        String
  externalName      String?
  // Optional Linear filters: issues must be in this Linear project, and/or
  // carry at least one of these labels. Also applied to issues created here.
  linearProjectId   String?
  linearProjectName String?
  labelIds          String[]  @default([])
  labelNames        String[]  @default([])
  // Create/update Linear issues when tasks change in Consultainer.
  pushChanges       Boolean   @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([source, externalId])
}

model ExternalTaskLink {
  id           String    @id @default(cuid())
  source       String
  externalId   String
  externalUrl  String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

model ExternalTimeEntryLink {
  id         String   @id @default(cuid())
  source     String
  externalId String
  createdAt  DateTime @default(now())

  timeEntryId String    @unique
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

// ── Passkeys (WebAuthn) ───────────────────────────────────────────────────────

model Authenticator {
  id           String    @id @default(cuid())
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt
  transports   String?
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived challenge for an in-progress registration or login ceremony.
// userId is set for registration (we know who); null for a discoverable
// (usernameless) login ceremony, resolved to a user only after verification.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── SSO (OIDC) ─────────────────────────────────────────────────────────────
// Per-org OIDC identity provider (Okta, Authentik, etc.) — not gated behind a
// billing tier yet since no billing enforcement exists in the app (see
// pricing page discussion); wire that gate in when it does.

model SsoConnection {
  id                    String   @id @default(cuid())
  issuer                String
  clientId              String
  clientSecret          String
  authorizationEndpoint String
  tokenEndpoint         String
  jwksUri               String
  enabled               Boolean  @default(true)
  // Label for the login-page button ("Sign in with <displayName>").
  displayName           String?
  // Create an account (and org membership, with defaultRole) on first SSO
  // sign-in. When false, only people who already belong to the org — via
  // invite or the local admin — can sign in through the IdP.
  autoProvision         Boolean  @default(true)
  defaultRole           Role     @default(MEMBER)
  // Email domains the IdP is trusted for. Empty = any verified email the IdP
  // returns.
  allowedDomains        String[] @default([])
  // Accept the IdP's email even when it sends email_verified=false (or
  // omits it). Some IdPs, notably authentik 2025.10+, report every address
  // as unverified by default. Only safe if users can't set arbitrary emails
  // in the IdP, since the email is what links to an existing account.
  trustEmails           Boolean  @default(false)
  // Blocks password / magic-link / passkey login for everyone in the org
  // except OWNERs, who keep local login as a break-glass path.
  enforced              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

// Single-use, short-lived ticket bridging the OIDC callback (a plain Route
// Handler, where next-auth's signIn()/redirect() can't be called directly)
// to the "sso" Credentials provider, consumed via a Server Component page —
// same shape/reasoning as the passkey login ticket.
model SsoLoginTicket {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Holds a credentials signup that would otherwise link to a domain — join an
// existing org via auto-join, or claim a domain for a brand-new org — until
// the email is confirmed. Nothing is created (no User, no Membership, no
// domain claim) until the link is clicked; typing someone else's email at
// signup must not be enough to get into their org or squat their domain.
model PendingSignup {
  id              String   @id @default(cuid())
  token           String   @unique
  email           String
  name            String
  passwordHash    String
  orgName         String
  autoJoinOrgId   String?
  claimableDomain String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([email])
}

// Instance-wide (not per-organization) settings for a self-hosted install,
// as simple key/value rows.
//   publicUrl — the address people use to reach this instance, confirmed
//   at setup; base of links that leave the browser (emails, share links).
model InstanceSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum PaymentMethodType {
  ACH
  WIRE
  CHECK
  STRIPE_LINK
  PADDLE
  PAYPAL
  VENMO
  ZELLE
  CRYPTO
  OTHER
}

// How a client can pay: structured, typed entries (ACH, wire, a Stripe link,
// ...) printed on invoices and the client share page. Org-wide defaults have
// clientId null; if a client has any of its own, those replace the defaults
// for that client. Replaces the free-text paymentInstructions columns (kept
// only so old databases migrate; no longer read).
model PaymentMethod {
  id        String            @id @default(cuid())
  type      PaymentMethodType
  // Optional nickname shown as the heading, e.g. "Operating account".
  label     String?
  // Type-specific fields — see src/lib/payment-methods.ts.
  details   Json
  // Bank details default to the share page only, since a PDF can be
  // forwarded anywhere.
  showOnPdf Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId, clientId])
}
