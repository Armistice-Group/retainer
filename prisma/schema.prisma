generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum BillingType {
  HOURLY
  FLAT_FEE
  MILESTONE
}

enum ClientDocumentType {
  W9
  FORM_1099
  CONTRACT
  NDA
  SOW
  PROPOSAL
  REPORT
  REFERENCE
  OTHER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum LinkType {
  LOGIN
  GDRIVE
  ONEDRIVE
  BOX
  DOC
  REPO
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET15
  NET30
  NET45
  NET60
  NET90
  CUSTOM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum NotificationType {
  MEMBER_JOINED
  PROJECT_ASSIGNED
  TASK_ASSIGNED
  INVOICE_SENT
  INVOICE_PAID
  TIME_LOGGED
  RECURRING_INVOICE_GENERATED
  INVOICE_OVERDUE
  TASK_COMMENTED
  TASK_MENTIONED
  BUDGET_ALERT
  TIMESHEET_SUBMITTED
  TIMESHEET_REVIEWED
  INVOICE_VIEWED
  BILLING_CHANGED
  SECURITY_ALERT
  MEETINGS_TO_SORT
  ESTIMATE_ACCEPTED
  ESTIMATE_DECLINED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  EXPENSE_SUBMITTED
  EXPENSE_REVIEWED
  TASK_DUE_SOON
  DEADLINE_OVERDUE
  INVOICE_SEND_FAILED
}

enum Plan {
  FREE
  PAID
  // Adds Stripe Connect — the org can collect payment directly on invoices,
  // not just generate and send them.
  GROWTH
}

model Organization {
  id                         String                @id @default(cuid())
  name                       String
  slug                       String                @unique
  domain                     String?               @unique
  autoJoinDomain             Boolean               @default(true)
  invoicePrefix              String                @default("INV")
  nextInvoiceNumber          Int                   @default(1)
  // Estimates are numbered EST-0001, EST-0002, … per organization.
  nextEstimateNumber         Int                   @default(1)
  // Credit notes are numbered CN-0001, CN-0002, … per organization.
  nextCreditNoteNumber       Int                   @default(1)
  defaultCurrency            String                @default("USD")
  defaultTaxRate             Decimal               @default(0) @db.Decimal(5, 2)
  // Hourly bill rate for anyone without their own (Membership.billRate),
  // used when someone is put on a project. Null = not set (falls back to 0).
  defaultBillRate            Decimal?              @db.Decimal(10, 2)
  // Whose weekly time needs an admin's approval before it can be invoiced.
  timesheetApproval          TimesheetApprovalMode @default(OFF)
  // Starting payment terms for new invoices, unless the client or project
  // sets its own.
  defaultPaymentTerms        PaymentTerms          @default(NET30)
  // Applied to the billed rate on hourly line items at invoice-generation
  // time — a straight multiplier baked into the rate shown on the invoice,
  // never broken out as its own line. Distinct from defaultTaxRate, which
  // is a visible, itemized "Tax" line.
  overheadPercent            Decimal               @default(0) @db.Decimal(5, 2)
  externalBillingUrl         String?
  externalBillingLabel       String?
  // Free text, not a structured payment-method schema — orgs accept wildly
  // different combinations (ACH details, a Stripe/PayPal payment link, a
  // mailing address for checks), so a single configurable block that gets
  // printed verbatim on every invoice PDF is more useful than a rigid set of
  // fields most orgs would only partially fill in.
  paymentInstructions        String?               @db.Text
  // When true, paymentInstructions is withheld from the plain PDF (which can
  // be forwarded/leaked anywhere) and only shown on the authenticated client
  // share portal — for orgs whose instructions include bank/ACH details.
  paymentInstructionsPrivate Boolean               @default(false)
  slackWebhookUrl            String?
  // Per-alert Slack/email switches (see lib/alert-events.ts); missing keys
  // use each alert's defaults.
  alertSettings              Json                  @default("{}")
  // Days overdue at which clients get an emailed reminder, e.g. [3, 7, 14];
  // empty turns reminders off.
  overdueReminderDays        Int[]                 @default([])
  // Auto-filing to a file service (see lib/services/filing.ts): which service,
  // through whose connection, into which root folder, and what gets filed.
  filingProvider             String?
  filingConnectionId         String?
  filingRootId               String?
  filingRootUrl              String?
  filingRootName             String?
  fileInvoices               Boolean               @default(true)
  fileDocuments              Boolean               @default(true)
  filingLastError            String?
  // When the last weekly digest went out, so each week gets one.
  lastDigestAt               DateTime?
  // Where alert emails go; empty means the org's owners.
  alertEmails                String[]              @default([])
  logoUrl                    String?
  logoData                   Bytes?
  logoContentType            String?
  brandColor                 String?
  // Optional in-app branding: show the org's logo/name in the sidebar and on
  // the login page instead of Consultainer's, and/or use brandColor as the
  // UI accent. Off by default; invoices use the logo/color regardless.
  appBranding                Boolean               @default(false)
  appAccentFromBrand         Boolean               @default(false)
  // Everyone must use an authenticator app (TOTP) to get past the sign-in
  // gate in requireOrgContext. SSO sign-ins are exempt (the IdP owns MFA).
  requireTwoFactor           Boolean               @default(false)
  // Default for client share links: visitors prove they're one of the
  // client's contacts with an emailed code. Clients can override it.
  requireShareVerification   Boolean               @default(false)

  // A non-admin's logged expense above this amount needs OWNER/ADMIN
  // approval before it can be pulled onto an invoice; admins' own expenses
  // are always auto-approved regardless of amount.
  expenseApprovalThreshold Decimal @default(100) @db.Decimal(12, 2)

  // Legacy hosted-billing columns — unused on self-hosted instances (no plan
  // gating), kept so existing databases migrate cleanly.
  plan                     Plan    @default(FREE)
  stripeCustomerId         String? @unique
  stripeSubscriptionId     String? @unique
  stripeSubscriptionStatus String?

  // Stripe Connect — lets this org collect invoice payments
  // directly. chargesEnabled mirrors Stripe's own flag (set from
  // account.updated webhooks) rather than being inferred from "account
  // exists", since an Express account can exist mid-onboarding without
  // being able to actually take a payment yet.
  stripeConnectAccountId      String? @unique
  stripeConnectChargesEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships               Membership[]
  invites                   Invite[]
  clients                   Client[]
  projects                  Project[]
  timeEntries               TimeEntry[]
  invoices                  Invoice[]
  recurringInvoiceSchedules RecurringInvoiceSchedule[]
  billingCycles             ClientBillingCycle[]
  paymentMethods            PaymentMethod[]
  notifications             Notification[]
  apiKeys                   ApiKey[]
  auditLogs                 AuditLog[]
  timesheets                Timesheet[]
  calendarFeeds             CalendarFeed[]
  filedCopies               FiledCopy[]
  quickBooksConnection      QuickBooksConnection?
  linearConnection          LinearConnection?
  mercuryConnection         MercuryConnection?
  ssoConnection             SsoConnection?
  expenses                  Expense[]
  activeTimers              ActiveTimer[]
  agreementConnections      AgreementConnection[]
  agreements                Agreement[]
  vaultLinks                VaultLink[]
  importBatches             ImportBatch[]
  estimates                 Estimate[]
  payments                  Payment[]
  creditNotes               CreditNote[]
  creditApplications        CreditApplication[]
  calendarSubscriptions     CalendarSubscription[]
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String?
  name                   String
  twoFactorSecret        String?
  twoFactorEnabled       Boolean  @default(false)
  twoFactorRecoveryCodes String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  memberships                 Membership[]
  projectMembers              ProjectMember[]
  timeEntries                 TimeEntry[]
  timesheets                  Timesheet[]            @relation("TimesheetOwner")
  timesheetsReviewed          Timesheet[]            @relation("TimesheetReviewer")
  invitesSent                 Invite[]               @relation("InvitedBy")
  assignedTasks               Task[]
  notifications               Notification[]
  apiKeys                     ApiKey[]
  connectedQuickBooksAccounts QuickBooksConnection[]
  connectedLinearAccounts     LinearConnection[]
  connectedMercuryAccounts    MercuryConnection[]
  authenticators              Authenticator[]
  webAuthnChallenges          WebAuthnChallenge[]
  connectedSsoAccounts        SsoConnection[]
  ssoLoginTickets             SsoLoginTicket[]
  pendingEmailChanges         PendingEmailChange[]
  completedMilestones         Milestone[]
  uploadedClientDocuments     ClientDocument[]
  expensesSubmitted           Expense[]              @relation("ExpenseSubmittedBy")
  expensesApproved            Expense[]              @relation("ExpenseApprovedBy")
  taskComments                TaskComment[]
  watchedTasks                TaskWatcher[]
  activeTimer                 ActiveTimer?
  auditLogs                   AuditLog[]
  invoiceEvents               InvoiceEvent[]
  calendarFeeds               CalendarFeed[]
  calendarEvents              CalendarEvent[]
  calendarRules               CalendarRule[]
  connections                 UserConnection[]
  passwordResetTokens         PasswordResetToken[]
  twoFactorLoginTickets       TwoFactorLoginTicket[]
  estimatesResponded          Estimate[]             @relation("EstimateRespondedBy")
  paymentsRecorded            Payment[]              @relation("PaymentRecordedBy")
  creditNotesIssued           CreditNote[]           @relation("CreditNoteCreatedBy")
  creditApplications          CreditApplication[]    @relation("CreditApplicationAppliedBy")
  calendarSubscriptions       CalendarSubscription[]

  // Dashboard "Get more out of Consultainer" card, hidden for good.
  setupCardDismissedAt DateTime?

  // Bumped when the password is reset; sessions carry the value they were
  // issued with and stop working once it no longer matches (JWT sessions
  // can't be revoked any other way).
  sessionVersion Int @default(0)
}

enum MembershipType {
  EMPLOYEE
  CONTRACTOR
}

model Membership {
  id             String         @id @default(cuid())
  role           Role           @default(MEMBER)
  employmentType MembershipType @default(EMPLOYEE)
  // What an hour of this person's time costs the org (salary or contractor
  // rate), for profit on Reports. Owners and admins only; null = unknown.
  costRate       Decimal?       @db.Decimal(10, 2)
  // This person's usual hourly bill rate, prefilled when they're put on a
  // project (falls back to Organization.defaultBillRate). Owners and admins
  // only; never changes rates on projects they're already on.
  billRate       Decimal?       @db.Decimal(10, 2)

  // Contractor profile — self-edited from Profile, shown to clients on a
  // per-project approval review when requested for a CONTRACTOR.
  title             String?
  bio               String?
  resumeFileName    String?
  resumeFileData    Bytes?
  resumeContentType String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invite {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  email     String?
  role      Role      @default(MEMBER)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invitedById String?
  invitedBy   User?   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model Client {
  id                          String        @id @default(cuid())
  name                        String
  website                     String?
  description                 String?
  email                       String?
  phone                       String?
  address                     String?
  billingEmail                String?
  billingAddress              String?
  // Overrides Organization.paymentInstructions for this client's invoices
  // specifically (e.g. a client that only accepts wire transfer). Null means
  // "use the org default" — an empty override isn't representable on
  // purpose, since "this client has no payment instructions at all" isn't a
  // real state anyone wants; they'd just fall back to the org default.
  paymentInstructions         String?       @db.Text
  paymentInstructionsPrivate  Boolean?
  // Whether the org's payment methods are offered alongside the client's
  // own, minus any switched off for this client.
  useOrgPaymentMethods        Boolean       @default(true)
  excludedOrgPaymentMethodIds String[]      @default([])
  // Whether this client gets the org's overdue reminder emails.
  invoiceReminders            Boolean       @default(true)
  // Default terms for this client's invoices; null uses the org default.
  // Never CUSTOM (that means "pick a due date by hand").
  paymentTerms                PaymentTerms?
  status                      ClientStatus  @default(ACTIVE)
  shareToken                  String?       @unique
  // Null: the client link never expires.
  shareExpiresAt              DateTime?
  // Emailed-code check on this client's share pages (client + project
  // links); INHERIT follows Organization.requireShareVerification.
  shareVerification           ShareVerificationMode @default(INHERIT)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  quickbooksCustomerId String?
  mercuryCustomerId    String?

  contacts                  Contact[]
  links                     Link[]
  projects                  Project[]
  invoices                  Invoice[]
  documents                 ClientDocument[]
  agreements                Agreement[]
  vaultLinks                VaultLink[]
  recurringInvoiceSchedules RecurringInvoiceSchedule[]
  billingCycle              ClientBillingCycle?
  paymentMethods            PaymentMethod[]
  estimates                 Estimate[]
  payments                  Payment[]
  creditNotes               CreditNote[]
  creditApplications        CreditApplication[]
  shareSessions             ShareSession[]
  shareCodes                ShareCode[]

  @@index([orgId])
}

enum DocumentAccess {
  EVERYONE
  ADMINS
  SELECTED
}

enum DocumentSource {
  UPLOAD
  LINK
  GOOGLE_DRIVE
  DROPBOX
  ONEDRIVE
  NOTION
  BOX
}

enum DocumentAudience {
  // Only people in the organization (subject to `access`).
  INTERNAL
  // Also listed on the client's share links.
  CLIENT
}

// A client's (or one of its projects') document: either a file uploaded here,
// or a link to where it lives — Google Drive, Dropbox, OneDrive, Notion, Box,
// or any URL.
model ClientDocument {
  id                 String             @id @default(cuid())
  type               ClientDocumentType @default(OTHER)
  label              String?
  // Who can open it besides owners and the uploader: everyone in the org,
  // owners and admins, or only allowedUserIds (see lib/document-access).
  access             DocumentAccess     @default(EVERYONE)
  allowedUserIds     String[]           @default([])
  audience           DocumentAudience   @default(INTERNAL)
  source             DocumentSource     @default(UPLOAD)
  // Uploads: the file's name. Links: the item's title.
  fileName           String
  // Uploads only (null when stored in external object storage — storageKey).
  fileData           Bytes?
  storageKey         String?
  contentType        String?
  sizeBytes          Int?
  // Links: where it lives, and what the provider calls it.
  externalUrl        String?
  externalId         String?
  // file | folder | page | database
  externalKind       String?
  externalModifiedAt DateTime?
  uploadedAt         DateTime           @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Set for a project's documents; they show on the client too.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
}

model Contact {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  title            String?
  contactRole      String?
  isPrimary        Boolean  @default(false)
  receivesInvoices Boolean  @default(false)
  createdAt        DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Deleting a contact signs them out of the client's share pages.
  shareSessions ShareSession[]
  shareCodes    ShareCode[]

  @@index([clientId])
}

enum ShareVerificationMode {
  INHERIT
  ON
  OFF
}

// A visitor who proved, with an emailed code, that they're one of the
// client's contacts. The browser holds the raw token in an httpOnly cookie;
// only its SHA-256 is stored. Deleted on sign-out, contact removal, and when
// the client link is regenerated or revoked.
model ShareSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  // The address that was verified; the session only counts while the
  // contact still has it.
  email      String
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([clientId, lastSeenAt])
  @@index([contactId])
}

// A 6-digit code emailed to a client contact for the share-page check.
// Single use, 10 minutes, 5 tries. The browser holds a random challenge in a
// cookie; both it and the code are stored only as hashes.
model ShareCode {
  id            String    @id @default(cuid())
  challengeHash String    @unique
  codeHash      String
  email         String
  attempts      Int       @default(0)
  expiresAt     DateTime
  usedAt        DateTime?
  ip            String?
  createdAt     DateTime  @default(now())

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([contactId])
}

// One request against a DB-backed rate limit (lib/rate-limit.ts). The key is
// a SHA-256 of e.g. "share-code:ip:1.2.3.4", so no emails or IPs are stored.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A user can type any new email into "Change email" — this holds the change
// until they prove they control that inbox, so a compromised session can't
// be used to pivot into someone else's real address (and, downstream, claim
// their company's domain via org Security settings).
model PendingEmailChange {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  newEmail  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Single-use password reset link. Only a SHA-256 of the token is stored;
// issuing a new one invalidates the user's older unused ones.
model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  // Owner/admin who created the link from Settings → Members; null when the
  // person asked for it themselves ("Forgot password?").
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// The second step of a "Continue with Google" sign-in for an account with an
// authenticator app: Google said who they are, but no session exists until
// the code is entered on /login/two-factor/<token>. Single use, short-lived,
// and dropped after a few wrong codes. Only the SHA-256 of the token is kept.
model TwoFactorLoginTicket {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  failedAttempts Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Link {
  id    String   @id @default(cuid())
  label String
  url   String
  type  LinkType @default(OTHER)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([projectId])
}

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String?
  status           ProjectStatus @default(ACTIVE)
  startDate        DateTime?
  endDate          DateTime?
  confidential     Boolean       @default(false)
  budgetHours      Decimal?      @db.Decimal(7, 2)
  // Highest budget threshold (80 or 100, % of budgetHours) already alerted
  // on, so each is announced once; drops back when hours fall or the
  // budget grows, so it can fire again.
  budgetAlertLevel Int           @default(0)
  billingType      BillingType   @default(HOURLY)
  flatFeeAmount    Decimal?      @db.Decimal(12, 2)
  // Overrides the client's payment terms for invoices of only this
  // project's work; null uses the client's.
  paymentTerms     PaymentTerms?
  shareToken       String?       @unique
  // Null: the project link never expires.
  shareExpiresAt   DateTime?
  // Show tasks (and comments marked for the client) on the share page.
  shareTasks       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  links            Link[]
  members          ProjectMember[]
  tasks            Task[]
  timeEntries      TimeEntry[]
  invoiceLineItems InvoiceLineItem[]
  milestones       Milestone[]
  expenses         Expense[]
  externalLink     ExternalProjectLink?
  activeTimers     ActiveTimer[]
  calendarEvents   CalendarEvent[]
  documents        ClientDocument[]
  agreements       Agreement[]
  vaultLinks       VaultLink[]
  estimates        Estimate[]

  @@index([orgId])
  @@index([clientId])
}

model Milestone {
  id          String    @id @default(cuid())
  name        String
  description String?
  // 0 for a deliverable (billable = false).
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  dueDate     DateTime? @db.Date
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // false = a deliverable: tracked, dated and completed like any milestone,
  // but never offered for invoicing (generateInvoice, billing cycles and
  // unbilled reports all filter on billable = true).
  billable          Boolean   @default(true)
  // Set once the "overdue" reminder went out; cleared when the due date
  // changes, so a new date can be reminded about again.
  overdueNotifiedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Evidence of completion — required note plus an optional file or link,
  // captured atomically in the same action that marks the milestone done.
  // No separate evidence table: one completion event, one evidence bundle.
  completedAt    DateTime?
  completedById  String?
  completedBy    User?     @relation(fields: [completedById], references: [id], onDelete: SetNull)
  completionNote String?
  completionUrl  String?

  completionFileName        String?
  completionFileData        Bytes?
  completionStorageKey      String?
  completionFileContentType String?

  // Milestone-based invoicing: a completed milestone becomes its own line
  // item (quantity 1, rate = amount) when included on a generated invoice —
  // mirrors TimeEntry's invoiceLineItemId, but @unique since a milestone
  // always maps to exactly one line item rather than being grouped.
  invoiceLineItemId String?          @unique
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)
  invoicedAt        DateTime?

  @@index([projectId])
}

model Task {
  id                    String     @id @default(cuid())
  title                 String
  description           String?
  status                TaskStatus @default(TODO)
  estimatedHours        Decimal?   @db.Decimal(6, 2)
  // Set once logged hours pass the estimate and we've said so; cleared if
  // they drop back under (or the estimate grows).
  overEstimateAlertedAt DateTime?
  dueDate               DateTime?  @db.Date
  // Deadline reminders already sent for the current due date (cleared when
  // it changes): "due tomorrow" and "overdue".
  dueSoonNotifiedAt     DateTime?
  overdueNotifiedAt     DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  timeEntries  TimeEntry[]
  externalLink ExternalTaskLink?
  activeTimers ActiveTimer[]
  watchers     TaskWatcher[]
  comments     TaskComment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([dueDate])
}

// Internal discussion on a task — never shown on the client share link. When
// the task is linked to a Linear issue the author can also post the comment
// there; externalId/externalUrl then point at the Linear comment.
model TaskComment {
  id               String   @id @default(cuid())
  body             String
  // "app" for comments written here, "linear" for ones pulled in from the
  // task's Linear issue (which have no author here, only externalAuthor).
  source           String   @default("app")
  // The Linear comment: the copy we posted, or the one we pulled in.
  externalId       String?  @unique
  externalUrl      String?
  // Who wrote a pulled-in comment, as Linear names them.
  externalAuthor   String?
  // Shown to the client on the project's share page (when the project
  // shares its tasks). Internal by default.
  sharedWithClient Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

// People following a task beyond its assignee: they get its comment
// notifications. Commenting or being @mentioned adds you; anyone can
// watch or unwatch from the task sheet.
model TaskWatcher {
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

enum ProjectMemberApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model ProjectMember {
  id       String  @id @default(cuid())
  billRate Decimal @default(0) @db.Decimal(10, 2)
  currency String  @default("USD")

  // Client review of a contractor's staffing on this project — optional,
  // requested by an admin when adding a CONTRACTOR. NOT_REQUIRED (the
  // default) means no review was ever asked for; approvalToken is only set
  // while a review is pending or has been responded to.
  approvalStatus      ProjectMemberApprovalStatus @default(NOT_REQUIRED)
  approvalToken       String?                     @unique
  approvalRequestedAt DateTime?
  approvalRespondedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Expense {
  id          String        @id @default(cuid())
  description String
  category    String?
  amount      Decimal       @db.Decimal(12, 2)
  incurredAt  DateTime      @db.Date
  status      ExpenseStatus @default(APPROVED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)

  approvedById String?
  approvedBy   User?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  receiptFileName    String?
  receiptFileData    Bytes?
  // Set instead of receiptFileData when uploads go to object storage.
  receiptStorageKey  String?
  receiptContentType String?

  // Mirrors Milestone: an approved, unbilled expense becomes its own line
  // item (quantity 1, rate = amount) when pulled onto a generated invoice.
  invoiceLineItemId String?          @unique
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)
  invoicedAt        DateTime?

  @@index([orgId])
  @@index([projectId])
}

model TimeEntry {
  id           String    @id @default(cuid())
  date         DateTime  @db.Date
  hours        Decimal   @db.Decimal(5, 2)
  description  String?
  billable     Boolean   @default(true)
  // Set when the week's timesheet is approved; cleared if it's sent back.
  // Entries that never needed approval leave it null (invoiceableTimeWhere).
  approvedAt   DateTime?
  rateOverride Decimal?  @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  invoiceLineItemId String?
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)

  externalLink  ExternalTimeEntryLink?
  calendarEvent CalendarEvent?
  importRecord  ImportRecord?

  @@index([orgId])
  @@index([projectId])
  @@index([userId])
  @@index([date])
  @@index([taskId])
}

// The one currently-running timer for a user, app-wide — not per-org, since
// a person is only ever doing one thing at a time regardless of which org's
// work it's for. Stopping it converts the elapsed duration into a real
// TimeEntry; starting a new one while another is running stops-and-logs the
// old one first rather than blocking, matching how Toggl/Harvest behave.
enum TimesheetApprovalMode {
  OFF
  CONTRACTORS
  EVERYONE
}

enum TimesheetStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

// A person's week of time, once they submit it for approval. No row means
// the week is still a draft. Weeks start Monday (weekStart is that date).
model Timesheet {
  id          String          @id @default(cuid())
  weekStart   DateTime        @db.Date
  status      TimesheetStatus
  // Reviewer's note, e.g. what to fix when sending a week back.
  note        String?
  submittedAt DateTime
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TimesheetOwner", fields: [userId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("TimesheetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([orgId, userId, weekStart])
  @@index([orgId, status])
}

// A person's calendar subscription (.ics link). Its meetings are pulled in
// as CalendarEvents for them to sort into projects (or ignore).
model CalendarFeed {
  id           String    @id @default(cuid())
  name         String
  // The secret iCal address — encrypted, since it reveals the calendar.
  url          String
  lastSyncedAt DateTime?
  lastError    String?
  // Last "meetings to sort" nudge, so it's at most daily.
  lastNudgedAt DateTime?
  createdAt    DateTime  @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  events CalendarEvent[]

  @@index([userId])
}

enum CalendarEventStatus {
  PENDING
  LOGGED
  IGNORED
}

// One occurrence of a meeting from a feed. PENDING ones are "to sort";
// logging one creates a time entry for its duration.
model CalendarEvent {
  id                 String              @id @default(cuid())
  // iCal UID — shared by every occurrence of a recurring meeting.
  uid                String
  title              String
  location           String?
  start              DateTime
  end                DateTime
  // Other attendees' email addresses, lowercased.
  attendees          String[]            @default([])
  status             CalendarEventStatus @default(PENDING)
  suggestedProjectId String?
  suggestionReason   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  feedId String
  feed   CalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  timeEntryId String?    @unique
  timeEntry   TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  @@unique([feedId, uid, start])
  @@index([userId, status, start])
  @@index([uid])
}

// "Always put this series / these attendees on that project" (projectId
// null = always ignore), learned when someone sorts a meeting.
model CalendarRule {
  id        String   @id @default(cuid())
  // SERIES: value is an iCal UID. DOMAIN: an attendee email domain.
  kind      String
  value     String
  projectId String?
  // Whether meetings logged by this rule are billable.
  billable  Boolean  @default(true)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, value])
}

// A person's secret calendar subscription (iCal) of the deadlines they can
// see in one org: task and milestone due dates, project dates and (owners and
// admins) invoice dates. Only a hash of the token in the URL is stored; what
// the feed shows is worked out from the person's access each time it's read.
model CalendarSubscription {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  lastFetchedAt DateTime?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

// A person's own connection to a file/doc service, used to browse and look up
// what they link (with their own permissions — never shared with others).
model UserConnection {
  id           String    @id @default(cuid())
  // GOOGLE_DRIVE | DROPBOX | ONEDRIVE | NOTION
  provider     String
  accountEmail String?
  accountName  String?
  // Encrypted.
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// A copy of an invoice PDF or uploaded document filed to the org's file
// service, so it's updated rather than duplicated, and linked back to.
model FiledCopy {
  id          String   @id @default(cuid())
  // INVOICE | DOCUMENT
  kind        String
  sourceId    String
  provider    String
  externalId  String
  externalUrl String?
  filedAt     DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([kind, sourceId, provider])
  @@index([orgId])
}

model ActiveTimer {
  id          String   @id @default(cuid())
  startedAt   DateTime @default(now())
  description String?
  billable    Boolean  @default(true)
  createdAt   DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model Invoice {
  id                      String        @id @default(cuid())
  number                  String
  status                  InvoiceStatus @default(DRAFT)
  issueDate               DateTime      @db.Date
  dueDate                 DateTime      @db.Date
  paymentTerms            PaymentTerms  @default(NET30)
  poNumber                String?
  paymentMethod           String?
  /// When the invoice became PAID (cleared if it leaves PAID).
  paidAt                  DateTime?
  subtotal                Decimal       @default(0) @db.Decimal(12, 2)
  taxRate                 Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount               Decimal       @default(0) @db.Decimal(12, 2)
  total                   Decimal       @default(0) @db.Decimal(12, 2)
  currency                String        @default("USD")
  notes                   String?
  // Guards notifyNewlyOverdueInvoices against sending a duplicate ping if the
  // daily cron ever fires more than once while an invoice is still exactly
  // one day overdue (manual re-trigger, EventBridge retry, etc).
  overdueNotifiedAt       DateTime?
  // Unguessable token for the client-facing invoice link (/i/<token>),
  // created the first time the invoice is emailed or its link copied.
  viewToken               String?       @unique
  // Client opens of the emailed invoice, its link or its PDF (not ours).
  firstViewedAt           DateTime?
  lastViewedAt            DateTime?
  viewCount               Int           @default(0)
  // Last "client opened this" alert, so repeat opens alert at most daily.
  viewAlertedAt           DateTime?
  // Snapshot of the schedule's retainerHours at generation time (not a live
  // lookup) so a client's billed-vs-logged balance stays accurate even if the
  // schedule's hours are edited later. Only set for retainer-generated
  // invoices whose schedule tracks hours.
  retainerHoursIncluded   Decimal?      @db.Decimal(8, 2)
  // Set once a "Pay now" checkout is started/completed for this invoice
  // (Growth plan, Stripe Connect). paymentIntentId is the actual proof of
  // payment the webhook uses to mark PAID — sessionId alone isn't, since a
  // session can be abandoned without paying.
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?       @unique
  // Same idea as the Stripe fields above, for orgs paying through a
  // connected Mercury account instead — mercuryInvoiceId is Mercury's own
  // invoice id (used to poll status, since Mercury doesn't webhook invoice
  // payments), mercuryInvoiceSlug builds the hosted pay page URL. Set once,
  // on first "Pay now" click, so repeat clicks reuse the same Mercury
  // invoice instead of creating duplicates.
  mercuryInvoiceId        String?       @unique
  mercuryInvoiceSlug      String?
  // What the Mercury invoice above asks for (the balance when it was made),
  // so a changed balance gets a fresh Mercury invoice.
  mercuryInvoiceAmount    Decimal?      @db.Decimal(12, 2)
  kind                    InvoiceKind   @default(STANDARD)
  // Sums of Payment.amount and CreditApplication.amount for this invoice,
  // kept in step by src/lib/services/payments.ts. Balance due is
  // total − amountPaid − creditApplied.
  amountPaid              Decimal       @default(0) @db.Decimal(12, 2)
  creditApplied           Decimal       @default(0) @db.Decimal(12, 2)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  quickbooksInvoiceId String?
  quickbooksSyncedAt  DateTime?

  lineItems InvoiceLineItem[]

  recurringScheduleId String?
  recurringSchedule   RecurringInvoiceSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  events              InvoiceEvent[]
  payments            Payment[]
  creditApplications  CreditApplication[]
  creditNotes         CreditNote[]

  // A draft set to be emailed to the client on its own (the hourly job sends
  // it once this time has passed). scheduledSendById is who scheduled it —
  // replies go to them. scheduledSendError is why the last attempt failed;
  // the invoice stays a draft and isn't retried until it's rescheduled.
  scheduledSendAt    DateTime?
  scheduledSendById  String?
  scheduledSendError String?

  @@unique([orgId, number])
  @@index([orgId])
  @@index([clientId])
  @@index([scheduledSendAt])
}

enum RecurringInterval {
  WEEKLY
  BIWEEKLY
  // Runs on the 1st and 15th of each month.
  SEMIMONTHLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// A retainer-style billing schedule: a flat amount charged to a client on a
// recurring cadence. Deliberately separate from generateInvoice's time/
// milestone/expense-driven flow — a retainer charge isn't "unbilled" work,
// it's a standing fee, so each run creates one manual line item rather than
// pulling in TimeEntry/Milestone/Expense records.
model RecurringInvoiceSchedule {
  id            String            @id @default(cuid())
  description   String
  amount        Decimal           @db.Decimal(12, 2)
  interval      RecurringInterval @default(MONTHLY)
  dueInDays     Int               @default(30)
  // Optional — lets a retainer be tracked in hours (e.g. "$5,000/mo = 40 hrs")
  // so the client page can show a running billed-vs-logged balance. Null for
  // retainers that are just a flat fee with no hours dimension.
  retainerHours Decimal?          @db.Decimal(8, 2)
  active        Boolean           @default(true)
  // Draft by default so a human reviews before it goes out; an org that
  // trusts the schedule can flip this on to skip that step.
  autoSend      Boolean           @default(false)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  generatedInvoices Invoice[]

  @@index([orgId])
  @@index([clientId])
  @@index([nextRunAt])
}

// Optional per-client billing cadence for ordinary (non-retainer) work: on
// each run, everything unbilled for the client — billable time, completed
// milestones, approved expenses — dated before the run date is rolled into
// one invoice via the same generateInvoice() path as the manual flow. A run
// with nothing to bill creates no invoice and just advances.
model ClientBillingCycle {
  id            String            @id @default(cuid())
  interval      RecurringInterval
  // Day of month the cycle was started on, so monthly-or-longer cycles that
  // get clamped (Jan 31 → Feb 28) snap back to the 31st afterwards instead
  // of drifting.
  anchorDay     Int
  paymentTerms  PaymentTerms      @default(NET30)
  // Draft by default so a human reviews before it goes out.
  autoSend      Boolean           @default(false)
  active        Boolean           @default(true)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  // Outcome of the last run, for display: the invoice it created, or why it
  // didn't create one.
  lastInvoiceId String?
  lastRunNote   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
}

enum InvoiceEventType {
  EMAILED
  REMINDED
  EMAIL_OPENED
  VIEWED
  PDF_VIEWED
  // A bank (ACH) payment started through "Pay now" and is clearing.
  PAYMENT_PROCESSING
  // A bank payment started through "Pay now" failed after all.
  PAYMENT_FAILED
}

// What happened to an invoice on its way to being paid: emails and
// reminders sent, and the client opening it.
model InvoiceEvent {
  id         String           @id @default(cuid())
  type       InvoiceEventType
  recipients String[]         @default([])
  // e.g. the reminder's days-overdue threshold.
  detail     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime         @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(8, 2)
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  timeEntries TimeEntry[]
  milestone   Milestone?
  expense     Expense?

  @@index([invoiceId])
}

// An ordinary invoice, or a deposit/advance billed up front whose payments
// become client credit (CreditApplication spends it on later invoices).
enum InvoiceKind {
  STANDARD
  DEPOSIT
}

enum PaymentSource {
  MANUAL
  STRIPE
  MERCURY
  QUICKBOOKS
}

// Money received against an invoice. Invoice.amountPaid is the sum of these
// (kept in step by src/lib/services/payments.ts); an invoice is PAID once
// total − amountPaid − creditApplied reaches zero.
model Payment {
  id         String        @id @default(cuid())
  amount     Decimal       @db.Decimal(12, 2)
  currency   String
  receivedAt DateTime      @db.Date
  source     PaymentSource @default(MANUAL)
  // Free text: "Wire", "Check #1042", …
  method     String?
  reference  String?
  note       String?
  // Idempotency key for payments recorded by an integration, e.g.
  // "stripe:pi_123" or "mercury:<invoice id>". Null for manual payments.
  externalId String?       @unique
  createdAt  DateTime      @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  recordedById String?
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([orgId, receivedAt])
  @@index([invoiceId])
  @@index([clientId])
}

enum CreditNoteStatus {
  ISSUED
  VOID
}

// Credit given to a client (CN-0001, …), optionally against an invoice.
// Adds to the client's available credit until applied to an invoice.
model CreditNote {
  id        String           @id @default(cuid())
  number    String
  amount    Decimal          @db.Decimal(12, 2)
  currency  String
  reason    String           @db.Text
  issueDate DateTime         @db.Date
  status    CreditNoteStatus @default(ISSUED)
  voidedAt  DateTime?
  createdAt DateTime         @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("CreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([clientId])
}

// Client credit (deposit payments, credit notes, overpayments) spent on an
// invoice. Invoice.creditApplied is the sum of these.
model CreditApplication {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  currency  String
  note      String?
  createdAt DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  appliedById String?
  appliedBy   User?   @relation("CreditApplicationAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([invoiceId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([orgId])
}

// Who changed what, for org admins. Written by the Prisma extension in
// lib/audit.ts on every write to an audited model, plus sign-ins.
model AuditLog {
  id          String   @id @default(cuid())
  action      String // create | update | delete | sign_in
  entityType  String // Prisma model name, e.g. "Task"
  entityId    String?
  entityLabel String?
  // create: { field: value }; update: { field: { from, to } }
  changes     Json?
  // Set on bulk writes, which get one entry for all rows.
  count       Int?
  via         String // web | api | system
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, createdAt])
  @@index([orgId, actorId, createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
}

model QuickBooksConnection {
  id                   String   @id @default(cuid())
  realmId              String
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  defaultItemId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

// Mercury Bank — an alternative to Stripe Connect for Growth-plan orgs that
// already bank with Mercury. Unlike QuickBooks/Linear above, this isn't an
// OAuth app we operate (Mercury's OAuth requires Mercury's own manual
// platform approval before we could get client credentials at all) — the
// org generates its own long-lived personal API token in their Mercury
// dashboard (Settings > Tokens) and pastes it in, so there's no redirect
// flow and no refresh token to manage. destinationAccountId is which of the
// org's Mercury checking accounts invoice payments land in.
model MercuryConnection {
  id                     String   @id @default(cuid())
  apiToken               String
  destinationAccountId   String?
  destinationAccountName String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

// ── Task tracker / time tracker integrations ─────────────────────────────────
// Generic mapping layer: any external source (Linear, Rize, Laurel, ...) links
// into Retainer's own Project/Task/TimeEntry rows via these tables, tagged by
// a `source` string, rather than each integration needing its own schema.

model LinearConnection {
  id                   String    @id @default(cuid())
  workspaceName        String?
  accessToken          String
  // Linear access tokens last 24h; the refresh token rotates on every use.
  // Both encrypted. Null on connections made before refresh tokens existed.
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  scope                String?
  // Linear's organization id — webhooks carry it, so it's how an incoming
  // event finds this connection. Filled in on first use for older rows.
  linearOrgId          String?
  // Last webhook delivery accepted for this connection, shown in settings.
  lastWebhookAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  @@index([linearOrgId])
}

model ExternalProjectLink {
  id                String    @id @default(cuid())
  source            String
  // Linear: the team. Several Consultainer projects (one per client, say)
  // can share a team, each narrowed by a Linear project and/or labels below.
  externalId        String
  externalName      String?
  // Optional Linear filters: issues must be in this Linear project, and/or
  // carry at least one of these labels. Also applied to issues created here.
  linearProjectId   String?
  linearProjectName String?
  labelIds          String[]  @default([])
  labelNames        String[]  @default([])
  // Create/update Linear issues when tasks change in Consultainer.
  pushChanges       Boolean   @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([source, externalId])
}

model ExternalTaskLink {
  id           String    @id @default(cuid())
  source       String
  externalId   String
  // Human-readable issue key shown on the task, e.g. RING-12 for Linear.
  externalKey  String?
  externalUrl  String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

model ExternalTimeEntryLink {
  id         String   @id @default(cuid())
  source     String
  externalId String
  createdAt  DateTime @default(now())

  timeEntryId String    @unique
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

// ── Passkeys (WebAuthn) ───────────────────────────────────────────────────────

model Authenticator {
  id           String    @id @default(cuid())
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt
  transports   String?
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived challenge for an in-progress registration or login ceremony.
// userId is set for registration (we know who); null for a discoverable
// (usernameless) login ceremony, resolved to a user only after verification.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── SSO (OIDC) ─────────────────────────────────────────────────────────────
// Per-org OIDC identity provider (Okta, Authentik, etc.) — not gated behind a
// billing tier yet since no billing enforcement exists in the app (see
// pricing page discussion); wire that gate in when it does.

model SsoConnection {
  id                    String   @id @default(cuid())
  issuer                String
  clientId              String
  clientSecret          String
  authorizationEndpoint String
  tokenEndpoint         String
  jwksUri               String
  enabled               Boolean  @default(true)
  // Label for the login-page button ("Sign in with <displayName>").
  displayName           String?
  // Create an account (and org membership, with defaultRole) on first SSO
  // sign-in. When false, only people who already belong to the org — via
  // invite or the local admin — can sign in through the IdP.
  autoProvision         Boolean  @default(true)
  defaultRole           Role     @default(MEMBER)
  // Email domains the IdP is trusted for. Empty = any verified email the IdP
  // returns.
  allowedDomains        String[] @default([])
  // Accept the IdP's email even when it sends email_verified=false (or
  // omits it). Some IdPs, notably authentik 2025.10+, report every address
  // as unverified by default. Only safe if users can't set arbitrary emails
  // in the IdP, since the email is what links to an existing account.
  trustEmails           Boolean  @default(false)
  // Blocks password / magic-link / passkey login for everyone in the org
  // except OWNERs, who keep local login as a break-glass path.
  enforced              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

// Single-use, short-lived ticket bridging the OIDC callback (a plain Route
// Handler, where next-auth's signIn()/redirect() can't be called directly)
// to the "sso" Credentials provider, consumed via a Server Component page —
// same shape/reasoning as the passkey login ticket.
model SsoLoginTicket {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Holds a credentials signup that would otherwise link to a domain — join an
// existing org via auto-join, or claim a domain for a brand-new org — until
// the email is confirmed. Nothing is created (no User, no Membership, no
// domain claim) until the link is clicked; typing someone else's email at
// signup must not be enough to get into their org or squat their domain.
model PendingSignup {
  id              String   @id @default(cuid())
  token           String   @unique
  email           String
  name            String
  passwordHash    String
  orgName         String
  autoJoinOrgId   String?
  claimableDomain String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([email])
}

// Instance-wide (not per-organization) settings for a self-hosted install,
// as simple key/value rows.
//   publicUrl — the address people use to reach this instance, confirmed
//   at setup; base of links that leave the browser (emails, share links).
model InstanceSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum PaymentMethodType {
  ACH
  WIRE
  CHECK
  STRIPE_LINK
  PADDLE
  PAYPAL
  VENMO
  ZELLE
  CRYPTO
  OTHER
}

// How a client can pay: structured, typed entries (ACH, wire, a Stripe link,
// ...) printed on invoices and the client share page. Org-wide defaults have
// clientId null; if a client has any of its own, those replace the defaults
// for that client. Replaces the free-text paymentInstructions columns (kept
// only so old databases migrate; no longer read).
model PaymentMethod {
  id        String            @id @default(cuid())
  type      PaymentMethodType
  // Optional nickname shown as the heading, e.g. "Operating account".
  label     String?
  // Type-specific fields — see src/lib/payment-methods.ts.
  details   Json
  // Bank details default to the share page only, since a PDF can be
  // forwarded anywhere.
  showOnPdf Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId, clientId])
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

// A quote for a client: line items, scope text and (optionally) the billing
// the resulting project would have. Once accepted it can become a project
// (projectId), with milestones from the lines flagged as milestones.
model Estimate {
  id          String         @id @default(cuid())
  number      String
  title       String
  // Scope / intro text; light markdown (headings, lists, bold, links),
  // rendered as React elements, never as raw HTML.
  intro       String?        @db.Text
  status      EstimateStatus @default(DRAFT)
  issueDate   DateTime       @db.Date
  // Last day the client can accept; null = never expires.
  expiresAt   DateTime?      @db.Date
  currency    String         @default("USD")
  subtotal    Decimal        @default(0) @db.Decimal(12, 2)
  taxRate     Decimal        @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal        @default(0) @db.Decimal(12, 2)
  total       Decimal        @default(0) @db.Decimal(12, 2)

  // What the project created from this estimate gets. Null budget = the
  // estimate's subtotal; null billing type = milestone-based when any line
  // is a milestone, else flat fee.
  proposedBillingType BillingType?
  // Hourly rate for an hourly project (budget hours = budget / rate).
  proposedRate        Decimal?     @db.Decimal(10, 2)
  proposedBudget      Decimal?     @db.Decimal(12, 2)

  // Unguessable token for the client-facing page (/e/<token>), created when
  // the estimate is first sent or its link copied.
  viewToken String?   @unique
  sentAt    DateTime?

  // The client's (or a manual) accept/decline: who, an optional note, and
  // for the client page, where from.
  respondedAt       DateTime?
  responderName     String?
  responseNote      String?
  responseIp        String?
  responseUserAgent String?
  // Set when someone in the org marked it accepted/declined by hand.
  respondedById     String?
  respondedBy       User?     @relation("EstimateRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // The existing project this quotes for, or the one created from it
  // (projectCreatedAt set). Estimates on a confidential project follow that
  // project's visibility.
  projectCreatedAt DateTime?
  projectId        String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  lineItems EstimateLineItem[]

  @@unique([orgId, number])
  @@index([orgId])
  @@index([clientId])
  @@index([projectId])
}

model EstimateLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(8, 2)
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  // Becomes a milestone (amount = this line's amount) on the project
  // created from the estimate. Due either on a date, or N days after the
  // estimate is accepted.
  isMilestone      Boolean   @default(false)
  milestoneDueDate DateTime? @db.Date
  milestoneDueDays Int?

  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

// One run of Settings → Import (a Harvest, Toggl, Clockify or generic CSV).
// Remembers what it created so it can be undone, and — through its
// ImportRecords — which rows of the file are already in, so importing the
// same file again adds nothing.
model ImportBatch {
  id                      String    @id @default(cuid())
  // harvest | toggl | clockify | generic
  source                  String
  // time | projects | clients
  kind                    String
  fileName                String
  rowCount                Int       @default(0)
  entriesCreated          Int       @default(0)
  clientsCreated          Int       @default(0)
  projectsCreated         Int       @default(0)
  rowsSkipped             Int       @default(0)
  // What this import added besides time entries, for "Undo import".
  createdClientIds        String[]  @default([])
  createdProjectIds       String[]  @default([])
  createdProjectMemberIds String[]  @default([])
  // No relation on purpose: the batch outlives the person who ran it.
  createdById             String?
  undoneAt                DateTime?
  createdAt               DateTime  @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  records ImportRecord[]

  @@index([orgId, createdAt])
}

// A file row that became a time entry. rowHash is stable for the same row
// in the same file, so a re-import skips it. Deleting the entry deletes
// this too (the row can then be imported again).
model ImportRecord {
  id      String @id @default(cuid())
  orgId   String
  rowHash String

  batchId String
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  timeEntryId String    @unique
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@unique([orgId, rowHash])
  @@index([batchId])
}

// ── Signed agreements (DocuSign, Documenso, Ironclad) ───────────────────────
// A one-way, read-only pull of completed envelopes/documents/records (see
// lib/services/agreements.ts). One connection per provider per org.
model AgreementConnection {
  id                   String    @id @default(cuid())
  // DOCUSIGN | DOCUMENSO | IRONCLAD
  provider             String
  // DocuSign: account id/name from /oauth/userinfo. Ironclad: the region.
  accountId            String?
  accountName          String?
  // DocuSign: the account's base_uri. Documenso: the instance URL.
  // Ironclad: the host (ironcladapp.com, eu1.ironcladapp.com, ...).
  baseUrl              String?
  // Encrypted. DocuSign: OAuth access token. Documenso: the API key.
  // Ironclad: the current client-credentials access token.
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  // Ironclad client credentials (the secret encrypted), and whose behalf
  // API calls are made on (x-as-user-email).
  clientId             String?
  clientSecret         String?
  actAsEmail           String?
  // Where the next pull starts (provider-side time), and how the last went.
  syncCursor           DateTime?
  lastSyncedAt         DateTime?
  lastError            String?
  connectedById        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
}

// One signed agreement pulled from a provider. Lands unmatched (clientId
// null) in the Agreements inbox until an owner/admin links it to a client
// (and optionally a project) or dismisses it; syncs never undo either.
model Agreement {
  id                String    @id @default(cuid())
  provider          String
  externalId        String
  title             String
  // The provider's own status word (completed, COMPLETED, executed).
  status            String
  signedAt          DateTime?
  // [{ name, email }]
  signers           Json      @default("[]")
  // Opens it in the provider.
  externalUrl       String?
  // Cached signed PDF (see lib/file-storage).
  fileName          String?
  fileData          Bytes?
  storageKey        String?
  contentType       String?
  sizeBytes         Int?
  // Best guess from signer email domains; only a suggestion.
  suggestedClientId String?
  dismissedAt       DateTime?
  dismissedById     String?
  linkedAt          DateTime?
  linkedById        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Unlinking (or deleting the client/project) puts it back in the inbox.
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([orgId, provider, externalId])
  @@index([orgId, clientId])
  @@index([clientId])
  @@index([projectId])
}

// A pointer to an item in a password manager (1Password, Bitwarden, …) so
// people can find the right credential for a client or project and open it
// in their vault. Never a secret: only the item's link, a label and a
// non-secret note. The vault decides who can open the item.
model VaultLink {
  id          String   @id @default(cuid())
  label       String
  // Non-secret context ("Use for Terraform only").
  note        String?
  url         String
  // ONEPASSWORD, BITWARDEN, KEEPER, DASHLANE, LASTPASS, PROTON_PASS or OTHER.
  provider    String
  // login, ssh_key, api_key, document or other — a hint only.
  itemKind    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Set: only people who can see the project see the link.
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([clientId])
  @@index([projectId])
}
