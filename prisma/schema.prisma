generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum LinkType {
  LOGIN
  GDRIVE
  DOC
  REPO
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum NotificationType {
  MEMBER_JOINED
  PROJECT_ASSIGNED
  TASK_ASSIGNED
  INVOICE_SENT
  INVOICE_PAID
  TIME_LOGGED
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  domain               String?  @unique
  autoJoinDomain       Boolean  @default(true)
  invoicePrefix        String   @default("INV")
  nextInvoiceNumber    Int      @default(1)
  defaultCurrency      String   @default("USD")
  defaultTaxRate       Decimal  @default(0) @db.Decimal(5, 2)
  externalBillingUrl   String?
  externalBillingLabel String?
  slackWebhookUrl      String?
  logoUrl              String?
  logoData             Bytes?
  logoContentType      String?
  brandColor           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships          Membership[]
  invites              Invite[]
  clients              Client[]
  projects             Project[]
  timeEntries          TimeEntry[]
  invoices             Invoice[]
  notifications        Notification[]
  apiKeys              ApiKey[]
  quickBooksConnection QuickBooksConnection?
  githubConnection     GithubConnection?
  linearConnection     LinearConnection?
  laurelConnection     LaurelConnection?
  ssoConnection        SsoConnection?
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String?
  name                   String
  twoFactorSecret        String?
  twoFactorEnabled       Boolean  @default(false)
  twoFactorRecoveryCodes String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  memberships                 Membership[]
  projectMembers              ProjectMember[]
  timeEntries                 TimeEntry[]
  invitesSent                 Invite[]               @relation("InvitedBy")
  assignedTasks               Task[]
  notifications               Notification[]
  apiKeys                     ApiKey[]
  connectedQuickBooksAccounts QuickBooksConnection[]
  connectedGithubAccounts     GithubConnection[]
  connectedLinearAccounts     LinearConnection[]
  connectedLaurelAccounts     LaurelConnection[]
  authenticators              Authenticator[]
  webAuthnChallenges          WebAuthnChallenge[]
  connectedSsoAccounts        SsoConnection[]
  ssoLoginTickets             SsoLoginTicket[]
  pendingEmailChanges         PendingEmailChange[]
}

model Membership {
  id   String @id @default(cuid())
  role Role   @default(MEMBER)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invite {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  email     String?
  role      Role      @default(MEMBER)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invitedById String?
  invitedBy   User?   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model Client {
  id             String       @id @default(cuid())
  name           String
  description    String?
  email          String?
  phone          String?
  address        String?
  billingEmail   String?
  billingAddress String?
  status         ClientStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  quickbooksCustomerId String?

  contacts Contact[]
  links    Link[]
  projects Project[]
  invoices Invoice[]

  @@index([orgId])
}

model Contact {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  title            String?
  contactRole      String?
  isPrimary        Boolean  @default(false)
  receivesInvoices Boolean  @default(false)
  createdAt        DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// A user can type any new email into "Change email" — this holds the change
// until they prove they control that inbox, so a compromised session can't
// be used to pivot into someone else's real address (and, downstream, claim
// their company's domain via org Security settings).
model PendingEmailChange {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  newEmail  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Link {
  id    String   @id @default(cuid())
  label String
  url   String
  type  LinkType @default(OTHER)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([projectId])
}

model Project {
  id                     String        @id @default(cuid())
  name                   String
  description            String?
  status                 ProjectStatus @default(ACTIVE)
  startDate              DateTime?
  endDate                DateTime?
  codeHealthGateEnabled  Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  links            Link[]
  members          ProjectMember[]
  tasks            Task[]
  timeEntries      TimeEntry[]
  invoiceLineItems InvoiceLineItem[]
  repo             Repo?
  externalLink     ExternalProjectLink?

  @@index([orgId])
  @@index([clientId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  timeEntries  TimeEntry[]
  externalLink ExternalTaskLink?

  @@index([projectId])
  @@index([assigneeId])
}

model ProjectMember {
  id       String  @id @default(cuid())
  billRate Decimal @default(0) @db.Decimal(10, 2)
  currency String  @default("USD")

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model TimeEntry {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  hours        Decimal  @db.Decimal(5, 2)
  description  String?
  billable     Boolean  @default(true)
  rateOverride Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  invoiceLineItemId String?
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)

  externalLink ExternalTimeEntryLink?

  @@index([orgId])
  @@index([projectId])
  @@index([userId])
  @@index([date])
  @@index([taskId])
}

model Invoice {
  id        String        @id @default(cuid())
  number    String
  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @db.Date
  dueDate   DateTime      @db.Date
  subtotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxRate   Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount Decimal       @default(0) @db.Decimal(12, 2)
  total     Decimal       @default(0) @db.Decimal(12, 2)
  currency  String        @default("USD")
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  quickbooksInvoiceId String?
  quickbooksSyncedAt  DateTime?

  lineItems InvoiceLineItem[]

  @@unique([orgId, number])
  @@index([orgId])
  @@index([clientId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(8, 2)
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  timeEntries TimeEntry[]

  @@index([invoiceId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([orgId])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
}

model QuickBooksConnection {
  id                   String   @id @default(cuid())
  realmId              String
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  defaultItemId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

model GithubConnection {
  id          String   @id @default(cuid())
  login       String
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  repos Repo[]
}

model Repo {
  id          String   @id @default(cuid())
  githubOwner String
  githubName  String
  installedAt DateTime @default(now())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  connectionId String
  connection   GithubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  scans Scan[]

  @@index([connectionId])
}

model Scan {
  id        String   @id @default(cuid())
  score     Int
  findings  Json
  createdAt DateTime @default(now())

  repoId String
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, createdAt])
}

// ── Task tracker / time tracker integrations ─────────────────────────────────
// Generic mapping layer: any external source (Linear, Rize, Laurel, ...) links
// into Retainer's own Project/Task/TimeEntry rows via these tables, tagged by
// a `source` string, rather than each integration needing its own schema.

model LinearConnection {
  id            String   @id @default(cuid())
  workspaceName String?
  accessToken   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

model ExternalProjectLink {
  id           String   @id @default(cuid())
  source       String
  externalId   String
  externalName String?
  createdAt    DateTime @default(now())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

model ExternalTaskLink {
  id           String    @id @default(cuid())
  source       String
  externalId   String
  externalUrl  String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

model ExternalTimeEntryLink {
  id         String   @id @default(cuid())
  source     String
  externalId String
  createdAt  DateTime @default(now())

  timeEntryId String    @unique
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

// Laurel's data-sync endpoints (pending time entries, client/matter push) are
// provisioned per-customer by Laurel's solutions team and aren't in public
// docs — this connection stores the OAuth2 client_credentials, which is
// enough to authenticate; the actual sync endpoints are a follow-up
// (see Linear ARM-63) once a real customer/client ID pair exists.
model LaurelConnection {
  id           String    @id @default(cuid())
  customerId   String
  clientId     String
  clientSecret String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

// ── Passkeys (WebAuthn) ───────────────────────────────────────────────────────

model Authenticator {
  id           String    @id @default(cuid())
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt
  transports   String?
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived challenge for an in-progress registration or login ceremony.
// userId is set for registration (we know who); null for a discoverable
// (usernameless) login ceremony, resolved to a user only after verification.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── SSO (OIDC) ─────────────────────────────────────────────────────────────
// Per-org OIDC identity provider (Okta, Authentik, etc.) — not gated behind a
// billing tier yet since no billing enforcement exists in the app (see
// pricing page discussion); wire that gate in when it does.

model SsoConnection {
  id                    String   @id @default(cuid())
  issuer                String
  clientId              String
  clientSecret          String
  authorizationEndpoint String
  tokenEndpoint         String
  jwksUri               String
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  connectedById String?
  connectedBy   User?   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

// Single-use, short-lived ticket bridging the OIDC callback (a plain Route
// Handler, where next-auth's signIn()/redirect() can't be called directly)
// to the "sso" Credentials provider, consumed via a Server Component page —
// same shape/reasoning as the passkey login ticket.
model SsoLoginTicket {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Holds a credentials signup that would otherwise link to a domain — join an
// existing org via auto-join, or claim a domain for a brand-new org — until
// the email is confirmed. Nothing is created (no User, no Membership, no
// domain claim) until the link is clicked; typing someone else's email at
// signup must not be enough to get into their org or squat their domain.
model PendingSignup {
  id                   String   @id @default(cuid())
  token                String   @unique
  email                String
  name                 String
  passwordHash         String
  orgName              String
  autoJoinOrgId        String?
  claimableDomain      String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([email])
}
